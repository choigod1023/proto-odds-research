                    </div>

                    <div class="table-wrap" style="margin-top: 1rem;">
                        <table>
                            <thead>
                            <tr>
                                <th style="text-align: left; line-height: 1.6; padding: 20px 16px;">
                                    * 공식기록과 부가기록의 경우 차이가 발생할 수 있습니다.
                                    <br>* 경기 부가기록 데이터는 경기데이터 공급업체에서 제공한 기록 입니다. (공급업체 : Bepro11)
                                    <br>* 공식기록은 경기장에서 실시간으로 수집한 기록이고 부가기록은 영상기반으로 데이터를 수집한 것 입니다.
                                </th>
                            </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>

            <div class="pop-btn">
                <button type="button" onclick="closePlayerDetailPop();">닫기</button>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function() {
            
            

            $(".hFormation").text(separateNumber('442'))
            $(".aFormation").text(separateNumber('433'))
        });

        function separateNumber(number) {
            return number.toString().split('').join('-');
        }

        function selectTbl(tblType){
            $("#stTbl").css('display','none')
            $("#psTbl").css('display','none')
            $("#dfTbl").css('display','none')
            $("#gkTbl").css('display','none')
            $("#"+tblType+'Tbl').show();

            $(".st").removeClass('active')
            $(".ps").removeClass('active')
            $(".df").removeClass('active')
            $("."+tblType).addClass('active');

        }

        function playerDetailPop(teamId, playerId){
            var formData = new FormData();
            formData.append('MEET_YEAR', 2025)
            formData.append('MEET_SEQ', 2)
            formData.append('GAME_ID', 1)
            formData.append('TEAM_ID', teamId)
            formData.append('PLAYER_ID', playerId)

            $.ajax({
                url: "/api/ddf/match/getMatchRecordPlayerDetail.do",
                type: "POST",
                data: formData,
                enctype: "multipart/form-data",
                cache: false,
                contentType: false,
                processData: false,
                success: function (res) {
                    if (res.resultCode == "200") {
                        $("#playerPopPlayerDetail").click( function(){
                            var url = '/record/playerDetail.do?playerId='+playerId
                            window.open(url, '_blank');
                        })
                        var imgSrc = 'https://d2tfp74nsbbrkr.cloudfront.net'+res.data.playerImg;
                        $("#playerPopImg").css('background-image', `url(`+imgSrc+`)`);
                        var item = res.data.playerDetail;

                        if(item.backNo != null){ $("#playerPopBackNo").text(item.backNo); }
                        else{ $("#playerPopBackNo").text(''); }
                        if(item.playerName != null){ $("#playerPopPlayerName").text(item.playerName); }
                        else{ $("#playerPopPlayerName").text(''); }
                        if(item.teamName != null){ $("#playerPopTeamName").text(item.teamName); }
                        else{ $("#playerPopTeamName").text(''); }
                        if(item.playerPos != null){ $("#playerPopPositionName").text(item.playerPos); }
                        else{ $("#playerPopPositionName").text(''); }
                        if(item.nationality != null){ $("#playerPopNationality").text(item.nationality); }
                        else{ $("#playerPopNationality").text(''); }
                        if(item.age != null){ $("#playerPopAge").text(item.age); }
                        else{ $("#playerPopAge").text(''); }
                        if(item.playerPoint != null){ $(".pd_playerPoint").text(item.playerPoint); }
                        else{ $(".pd_playerPoint").text(''); }

                        
                        
                        if(item.minutePlay != null){ $(".pd_minutePlay").text(item.minutePlay + '분'); }
                        else{ $(".pd_minutePlay").text(''); }

                        if(item.adidasPoint != null){ $(".pd_adidasPoint").text(item.adidasPoint); }
                        else{ $(".pd_adidasPoint").text(''); }
                        


                        if(item.playerPos == 'GK'){
                            var item2 = res.data.playerGKDetail;
                            $("#detailTblOption").css('display','none')
                            $("#gkTbl").show();

                            $(".pd_goalConceded").text(item2.goalConceded);
                            $(".pd_catchh").text(item2.catchh);
                            $(".pd_punch").text(item2.punch);
                            $(".pd_goalkeeperSave").text(item2.goalkeeperSave);
                            $(".pd_goalKick").text(item2.goalKick);
                            $(".pd_goalKickSuccess").text(item2.goalKickSuccess);
                            $(".pd_airClearances").text(item2.airClearances);
                            $(".pd_airClearancesSuccess").text(item2.airClearancesSuccess);
                        }
                        else{
                            $("#detailTblOption").show();
                            $("#stTbl").show();
                            $(".st").addClass('active')
                            $(".ps").removeClass('active')
                            $(".df").removeClass('active')

                            $(".pd_goal").text(item.goal);
                            if(item.goal != 0 && item.goal != ''){
                                if(res.data.goalYoutube != null){
                                    $(".pd_goal").append('<button type="button" class="youtubePopupBtn" onclick="youtubePop()";>자세히</button>')

                                    $(".video-container").empty();
                                    var youtubeList = '';
                                    res.data.goalYoutube.forEach(function (item) {
                                        if(item.videoId != null){
                                            youtubeList += `<p><iframe allowfullscreen frameborder="0" src="//www.youtube.com/embed/`+item.videoId+`" width="380px;" height="245px;" class="note-video-clip"></iframe><br></p>`
                                        }
                                        else{
                                            youtubeList += item.contents.replace('width="640"', 'width="100%;"')
                                        }
                                    });
                                    $(".video-container").append(youtubeList);
                                }
                            }

                            $(".pd_assist").text(item.assist);
                            $(".pd_shot").text(item.shot);
                            $(".pd_shotOnTarget").text(item.shotOnTarget);
                            var tmpShotAcc = 0
                            if(item.shot != 0 && item.shot != ''){
                                tmpShotAcc = item.shotOnTarget * 100 / item.shot
                                tmpShotAcc = tmpShotAcc.toFixed(2);
                                tmpShotAcc = tmpShotAcc.replace('.00','')
                            }
                            $(".pd_shotAcc").text(tmpShotAcc+'%');

                            if(item.shotOnTarget != 0 && item.shotOnTarget != ''){
                                if(res.data.timeEvent.length != 0){
                                    $(".pd_shotAcc").append('<button type="button" class="shootPopupBtn" onclick="shootPop()";>자세히</button>')

                                    $("#canvas").empty();
                                    draw(res.data.timeEvent)
                                }
                            }

                            $(".pd_defenderBlockedShot").text(item.defenderBlockedShot);
                            $(".pd_shootingInPa").text(item.shootingInPa);
                            $(".pd_shootingOutPa").text(item.shootingOutPa);
                            $(".pd_offside").text(item.offside);
                            $(".pd_freekick").text(item.freekick);
                            $(".pd_corner").text(item.corner);
                            $(".pd_throwIns").text(item.throwIns);
                            $(".pd_dribble").text(item.dribbleSuccess + '/' + item.pcntSuccessDribble.replace('.00', '')+'%');
                            if($(".changeM_"+playerId).text() == ''){

                            }
                            else{
                                $(".pd_change").append('<i class="ic-lineup-change01"></i>'+$(".changeM_"+playerId).text()+ '\' '+ $(".changeP_"+playerId).text());
                            }


                            $(".pd_expectedGoal").text(item.expectedGoal);
                            $(".pd_passAcc").text(item.passAcc + '/' + item.pcntAccPass.replace('.00', '')+'%');
                            $(".pd_exAttKeyPass").text(item.exAttKeyPass);

                            var tmp ='';
                            if(item.attAreaPass != '' && item.attAreaPassSuccess != ''){
                                if(item.attAreaPass != 0 && item.attAreaPassSuccess != 0){
                                    tmp = 100 * item.attAreaPassSuccess / item.attAreaPass
                                    tmp = tmp.toFixed(2)
                                }
                                else{
                                    tmp = '0';
                                }
                                $(".pd_attAreaPassSuccess").text(item.attAreaPassSuccess + '/' + tmp.replace('.00', '')+'%');
                                tmp =''
                            }
                            if(item.middleAreaPass != '' && item.middleAreaPassSuccess != ''){
                                if(item.middleAreaPass != 0 && item.middleAreaPassSuccess != 0){
                                    tmp = 100 * item.middleAreaPassSuccess / item.middleAreaPass
                                    tmp = tmp.toFixed(2)
                                }
                                else{
                                    tmp = '0';
                                }
                                $(".pd_middleAreaPassSuccess").text(item.middleAreaPassSuccess + '/' + tmp.replace('.00', '')+'%');
                                tmp =''
                            }
                            if(item.defsAreaPass != '' && item.defsAreaPassSuccess != ''){
                                if(item.defsAreaPass != 0 && item.defsAreaPassSuccess != 0){
                                    tmp = 100 * item.defsAreaPassSuccess / item.defsAreaPass
                                    tmp = tmp.toFixed(2)
                                }
                                else{
                                    tmp = '0';
                                }
                                $(".pd_defsAreaPassSuccess").text(item.defsAreaPassSuccess + '/' + tmp.replace('.00', '')+'%');
                                tmp =''
                            }
                            if(item.longPass != '' && item.longPassSuccess != ''){
                                if(item.longPass != 0 && item.longPassSuccess != 0){
                                    tmp = 100 * item.longPassSuccess / item.longPass
                                    tmp = tmp.toFixed(2)
                                }
                                else{
                                    tmp = '0';
                                }
                                $(".pd_longPassSuccess").text(item.longPassSuccess + '/' + tmp.replace('.00', '')+'%');
                                tmp =''
                            }
                            if(item.mediumPass != '' && item.mediumPassSuccess != ''){
                                if(item.mediumPass != 0 && item.mediumPassSuccess != 0){
                                    tmp = 100 * item.mediumPassSuccess / item.mediumPass
                                    tmp = tmp.toFixed(2)
                                }
                                else{
                                    tmp = '0';
                                }
                                $(".pd_mediumPassSuccess").text(item.mediumPassSuccess + '/' + tmp.replace('.00', '')+'%');
                                tmp =''
                            }
                            if(item.shortPass != '' && item.shortPassSuccess != ''){
                                if(item.shortPass != 0 && item.shortPassSuccess != 0){
                                    tmp = 100 * item.shortPassSuccess / item.shortPass
                                    tmp = tmp.toFixed(2)
                                }
                                else{
                                    tmp = '0';
                                }
                                $(".pd_shortPassSuccess").text(item.shortPassSuccess + '/' + tmp.replace('.00', '')+'%');
                                tmp =''
                            }
                            $(".pd_passFCaDeg").text(item.passFCaDeg);
                            $(".pd_transversePassSuccess").text(item.transversePassSuccess);
                            $(".pd_passBCaDeg").text(item.passBCaDeg);
                            $(".pd_crosAcc").text(item.crosAcc + '/' + item.crosAccPcnt.replace('.00', '')+'%');
                            $(".pd_controlUnderPressure").text(item.controlUnderPressure);

                            $(".pd_chalgWon").text(item.chalgWon + '/' + item.pcntChalgWon.replace('.00', '')+'%');
                            $(".pd_airChalgWon").text(item.airChalgWon + '/' + item.airChallengePcnt.replace('.00', '')+'%');
                            $(".pd_tackleSuccess").text(item.tackleSuccess + '/' + item.pcntTackleWon.replace('.00', '')+'%');
                            $(".pd_intercept").text(item.intercept);
                            $(".pd_cutOff").text(item.cutOff);
                            $(".pd_ballRecoverie").text(item.ballRecoverie);
                            $(".pd_blockingShoot").text(item.blockingShoot);
                            $(".pd_ballMiss").text(item.ballMiss);
                            $(".pd_foul").text(item.foul);
                            $(".pd_foulSuffered").text(item.foulSuffered);
                            $(".pd_yellowCard").text(item.yellowCard);
                            $(".pd_redCard").text(item.redCard);
                        }
                    }
                    else{
                        alert(res.resultMsg);
                        return;
                    }
                },
                error: function (request, status, error) {
                    alert("code:" + request.status + "\n" + "message:" + request.responseText + "\n" + "error:" + error);
                }
            });

            $("#playerRecordPopup").addClass('active');
        }

