        <div class="player-pop-wrap" style="background-color: black;">
            <div class="pop-tit">
                <h6 style="color: white;">선수 개별 지표</h6>
                <i class="ico-close" onclick="closePlayerDetailPop();" style="background-image: url('/assets/images/icon/ico_close.png');"></i>
            </div>
            <div class="pop-cont">
                <div class="player-intro">
                    <div>
                        <div class="img" id="playerPopImg"></div>
                        <div class="popCont">
                            <div class="name"><div id="playerPopPlayerName"></div><p id="playerPopBackNo"></p></div>
                            <p id="playerPopTeamName"></p>
                            <button type="button" id="playerPopPlayerDetail">선수 상세정보</button>
                        </div>
                    </div>
                    <ul style="background-color: black;">
                        <li><h6>포지션</h6><p id="playerPopPositionName"></p></li>
                        <li><h6>국적</h6><p id="playerPopNationality"></p></li>
                        <li><h6>나이</h6><p id="playerPopAge"></p></li>
                    </ul>
                </div>

                <div class="player-info">
                    <ul class="tab" id="detailTblOption" style="background-color: #1A1A1A;">
                        <li onclick="javascript:selectTbl('st');" class="st">공격</li>
                        <li onclick="javascript:selectTbl('ps');" class="ps">패스</li>
                        <li onclick="javascript:selectTbl('df');" class="df">수비</li>
                    </ul>
                    <div class="table-wrap" style="display: none;" id="stTbl">
                        <table>
                            <thead>
