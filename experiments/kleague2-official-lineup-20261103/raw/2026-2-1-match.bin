<script>
    var attackDirection
    $(document).ready(function() {
        getAttackDirection(function(direction) {
            attackDirection = direction;
        });
    });
    function getAttackDirection(callback) {
        var playerList = [];
        playerList.push('20140201');
        var formData = new FormData();
        formData.append('MEET_YEAR', '2026')
        formData.append('MEET_SEQ', '2')
        formData.append('GAME_ID', '1')
        formData.append('PLAYER_LIST', playerList)
        formData.append('PERIOD_ID', 1)

        $.ajax({
            url: "/api/ddf/match/getAttackDirection.do",
            type: "POST",
            data: formData,
            enctype: "multipart/form-data",
            cache: false,
            contentType: false,
            processData: false,
            success: function (res) {
                if (res.resultCode == "200") {
                    if( res.data.attackDirection < 50){
                        callback(1);
                    } else {
                        callback(0);
                    }
                } else {
                    callback(1);
                }
            },
            error: function (err) {
                callback(1);
            }
        });
    }
</script>

<script>
    var shootDataInit = true;
    var passDataInit = true;
    $('ul.tab4_stat li').click(function(){
        var tab_id = $(this).attr('data-tab');

        $('ul.tab4_stat li').removeClass('active');
        $('.match-sub-tab-cont').removeClass('active');

        $(this).addClass('active');
        $('#'+tab_id).addClass('active');
        if(tab_id == 'sub-tab03'){
            if(shootDataInit){
                shootDataInit = false;
                getShootData();
            }
        }
        else if(tab_id == 'sub-tab05'){
            if(passDataInit){
                passDataInit = false;
                getPassData();
            }
        }
    })

    var homeAway = 'home'
    var stat = 'st'
    function showRecord(homeType, statType){
        if(homeType != ''){
            homeAway = homeType
        }
        if(statType != ''){
            stat = statType
        }

        if(homeAway == 'home'){
            $(".homeRecord").addClass('active')
            $(".awayRecord").removeClass('active')
            $(".homeRecordTbl").addClass('active')
            $(".awayRecordTbl").removeClass('active')
        }
        else{
            $(".homeRecord").removeClass('active')
            $(".awayRecord").addClass('active')
            $(".homeRecordTbl").removeClass('active')
            $(".awayRecordTbl").addClass('active')
        }

        $(".statTbl").removeClass('active')
        $("."+stat).addClass('active')
        $(".matchStatPartLi").removeClass('active')
        $("."+stat+'Li').addClass('active')

    }

    function getMatchRecordAllData(){
        $.ajax({
            url: "/api/ddf/match/getMatchRecordAllDetail.do",
            type: "POST",
            data: {
                'year': '2026',
                'yearTst': '2026',
                'meetSeq': '2',
                'gameId': '1',
                'gameIdTst': '1',
                'homeTeam': 'K41',
                'awayTeam': 'K32',
                'roundId': '1',
            },
            success: function (res) {
                if (res.resultCode == "200") {

                    $(".recordDetailTd").text('');
                    $(".graphSum").empty();

                    res.data.listH.forEach(function (item) {
                        var playerId = item.playerId;
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_playerPoint').append(item.playerPoint)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_adidasPoint').append(item.adidasPoint)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_minutePlay').append(item.minutePlay)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_goal').append(item.goal)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_assist').append(item.assist)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_shot').append(item.shot)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_shotOnTarget').append(item.shotOnTarget)
                        var tmpShotAcc = 0
                        if (item.shot != 0 && item.shot != '') {
                            tmpShotAcc = item.shotOnTarget * 100 / item.shot
                            tmpShotAcc = tmpShotAcc.toFixed(2);
                            tmpShotAcc = tmpShotAcc.replace('.00', '')
                        }
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_shotAcc').append(tmpShotAcc)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_expectedGoal').append(item.expectedGoal)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_shootingInPa').append(item.shootingInPa)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_shootingOutPa').append(item.shootingOutPa)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_offside').append(item.offside)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_freekick').append(item.freekick)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_corner').append(item.corner)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_throwIns').append(item.throwIns)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_dribble').append(item.dribble)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_passAcc').append(item.passAcc)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_exAttKeyPass').append(item.exAttKeyPass)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_attAreaPassSuccess').append(item.attAreaPassSuccess)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_middleAreaPassSuccess').append(item.middleAreaPassSuccess)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_defsAreaPassSuccess').append(item.defsAreaPassSuccess)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_longPassSuccess').append(item.longPassSuccess)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_mediumPassSuccess').append(item.mediumPassSuccess)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_shortPassSuccess').append(item.shortPassSuccess)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_passFCaDeg').append(item.passFCaDeg)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_transversePassSuccess').append(item.transversePassSuccess)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_passBCaDeg').append(item.passBCaDeg)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_crosAcc').append(item.crosAcc)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_controlUnderPressure').append(item.controlUnderPressure)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_chalgWon').append(item.chalgWon)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_airChalgWon').append(item.airChalgWon)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_tackleSuccess').append(item.tackleSuccess)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_intercept').append(item.intercept)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_cutOff').append(item.cutOff)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_ballRecoverie').append(item.ballRecoverie)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_blockingShoot').append(item.blockingShoot)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_ballMiss').append(item.ballMiss)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_foul').append(item.foul)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_foulSuffered').append(item.foulSuffered)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_yellowCard').append(item.yellowCard)
                        // 경고누적 퇴장은 퇴장 카운트 X
                        if (item.yellowCard === 2) {
                            $(".homeRecordTbl .statTbl tbody ." + playerId + '_redCard').append('0');
                        } else {
                            $(".homeRecordTbl .statTbl tbody ." + playerId + '_redCard').append(item.redCard);
                        }
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_goalConceded').append(item.goalConceded);
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_catchh').append(item.catchh)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_punch').append(item.punch)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_goalkeeperSave').append(item.goalkeeperSave)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_goalKick').append(item.goalKick)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_goalKickSuccess').append(item.goalKickSuccess)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_airClearances').append(item.airClearances)
                        $(".homeRecordTbl .statTbl tbody ." + playerId + '_airClearancesSuccess').append(item.airClearancesSuccess)
                    });

                    res.data.listA.forEach(function (item) {
                        var playerId = item.playerId;
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_playerPoint').append(item.playerPoint)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_adidasPoint').append(item.adidasPoint)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_minutePlay').append(item.minutePlay)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_goal').append(item.goal)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_assist').append(item.assist)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_shot').append(item.shot)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_shotOnTarget').append(item.shotOnTarget)
                        var tmpShotAcc = 0
                        if (item.shot != 0 && item.shot != '') {
                            tmpShotAcc = item.shotOnTarget * 100 / item.shot
                            tmpShotAcc = tmpShotAcc.toFixed(2);
                            tmpShotAcc = tmpShotAcc.replace('.00', '')
                        }
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_shotAcc').append(tmpShotAcc)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_expectedGoal').append(item.expectedGoal)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_shootingInPa').append(item.shootingInPa)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_shootingOutPa').append(item.shootingOutPa)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_offside').append(item.offside)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_freekick').append(item.freekick)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_corner').append(item.corner)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_throwIns').append(item.throwIns)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_dribble').append(item.dribble)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_passAcc').append(item.passAcc)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_exAttKeyPass').append(item.exAttKeyPass)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_attAreaPassSuccess').append(item.attAreaPassSuccess)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_middleAreaPassSuccess').append(item.middleAreaPassSuccess)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_defsAreaPassSuccess').append(item.defsAreaPassSuccess)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_longPassSuccess').append(item.longPassSuccess)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_mediumPassSuccess').append(item.mediumPassSuccess)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_shortPassSuccess').append(item.shortPassSuccess)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_passFCaDeg').append(item.passFCaDeg)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_transversePassSuccess').append(item.transversePassSuccess)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_passBCaDeg').append(item.passBCaDeg)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_crosAcc').append(item.crosAcc)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_controlUnderPressure').append(item.controlUnderPressure)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_chalgWon').append(item.chalgWon)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_airChalgWon').append(item.airChalgWon)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_tackleSuccess').append(item.tackleSuccess)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_intercept').append(item.intercept)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_cutOff').append(item.cutOff)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_ballRecoverie').append(item.ballRecoverie)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_blockingShoot').append(item.blockingShoot)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_ballMiss').append(item.ballMiss)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_foul').append(item.foul)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_foulSuffered').append(item.foulSuffered)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_yellowCard').append(item.yellowCard)
                        // 경고누적 퇴장은 퇴장 카운트 X
                        if (item.yellowCard === 2) {
                            $(".awayRecordTbl .statTbl tbody ." + playerId + '_redCard').append('0');
                        } else {
                            $(".awayRecordTbl .statTbl tbody ." + playerId + '_redCard').append(item.redCard);
                        }
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_goalConceded').append(item.goalConceded);
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_catchh').append(item.catchh)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_punch').append(item.punch)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_goalkeeperSave').append(item.goalkeeperSave)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_goalKick').append(item.goalKick)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_goalKickSuccess').append(item.goalKickSuccess)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_airClearances').append(item.airClearances)
                        $(".awayRecordTbl .statTbl tbody ." + playerId + '_airClearancesSuccess').append(item.airClearancesSuccess)
                    });
                    // 통계데이터
                    var keys = Object.keys(res.data.sumAll);
                    for(const key of keys){
                        if(dataTypeTxt(key) != ''){
                            var sum = res.data.sumAll[key]
                            var home = res.data.sumH[key]
                            var away = res.data.sumA[key]
                            if(sum != null){
                                setHtmlData(sum, home, away, key);
                            }
                        }
                    }

                } else {
                    alert(res.resultMsg);
                    return;
                }
            },
            error: function (request, status, error) {
                alert("code:" + request.status + "\n" + "message:" + request.responseText + "\n" + "error:" + error);
            }
        });
    }
    function setHtmlData(sum, home, away, dataType){
        var html = '';
        var widthH=0, widthA=0;
        if(sum > 0){
            widthH = Math.round(home*100/sum);
            widthA = Math.round(away*100/sum);
        }
        else{
            widthH = 0;
            widthA = 0;
        }
        html += `<li><div class="home K41"><p>`+home+`</p><div><span style="width: `+widthH+`%;"></span></div></div><p>`
        html += dataTypeTxt(dataType);
        html += `</p><div class="away K32"><p>`+away+`</p><div><span style="width: `+widthA+`%;"></span></div></div></li>`

        $(".sum_"+dataTypeArea(dataType)).append(html);
    }
    function dataTypeTxt(dataType){
        switch (dataType){
            case 'goal' :  return '득점'
            case 'assist' :  return '도움'
            case 'shot' :  return '슈팅'
            case 'shotOnTarget' :  return '유효슈팅'
            case 'shotAcc' :  return '슈팅정확도'
            case 'shootingInPa' :  return 'PA내슈팅'
            case 'shootingOutPa' :  return 'PA외슈팅'
            case 'offside' :  return '오프사이드'
            case 'freekick' :  return '프리킥'
            case 'corner' :  return '코너킥'
            case 'throwIns' :  return '스로인'
            case 'dribble' :  return '드리블'
            case 'passAcc' :  return '패스'
            case 'exAttKeyPass' :  return '키패스'
            case 'attAreaPassSuccess' :  return '공격진영패스'
            case 'middleAreaPassSuccess' :  return '중앙지역패스'
            case 'defsAreaPassSuccess' :  return '수비진영패스'
            case 'longPassSuccess' :  return '롱패스'
            case 'mediumPassSuccess' :  return '중거리패스'
            case 'shortPassSuccess' :  return '숏패스'
            case 'passFCaDeg' :  return '전진패스'
            case 'transversePassSuccess' :  return '횡패스'
            case 'passBCaDeg' :  return '백패스'
            case 'crosAcc' :  return '크로스'
            case 'controlUnderPressure' :  return '탈압박'
            case 'chalgWon' :  return '경합(지상)'
            case 'airChalgWon' :  return '경합(공중)'
            case 'tackleSuccess' :  return '태클'
            case 'intercept' :  return '인터셉트'
            case 'cutOff' :  return '차단'
            case 'ballRecoverie' :  return '획득'
            case 'blockingShoot' :  return '블락'
            case 'ballMiss' :  return '볼미스'
            case 'foul' :  return '파울'
            case 'foulSuffered' :  return '피파울'
            case 'yellowCard' :  return '경고'
            case 'redCard' :  return '퇴장'
            case 'goalConceded' :  return '실점'
            case 'catchh' :  return '캐칭'
            case 'punch' :  return '펀칭'
            case 'goalkeeperSave' :  return '선방'
            case 'goalKick' :  return '골킥'
            case 'goalKickSuccess' :  return '골킥성공'
            case 'airClearances' :  return '공중볼처리'
            case 'airClearancesSuccess' :  return '공중볼처리성공'
            default: return '';
        }
    }
    function dataTypeArea(dataType){
        switch (dataType){
            case 'goal' :  return 'st'  // gk, df, ps
            case 'assist' :  return 'st'
            case 'shot' :  return 'st'
            case 'shotOnTarget' :  return 'st'
            case 'shotAcc' :  return 'st'
            case 'shootingInPa' :  return 'st'
            case 'shootingOutPa' :  return 'st'
            case 'offside' :  return 'st'
            case 'freekick' :  return 'st'
            case 'corner' :  return 'st'
            case 'throwIns' :  return 'st'
            case 'dribble' :  return 'st'
            case 'passAcc' :  return 'ps'
            case 'exAttKeyPass' :  return 'ps'
            case 'attAreaPassSuccess' :  return 'ps'
            case 'middleAreaPassSuccess' :  return 'ps'
            case 'defsAreaPassSuccess' :  return 'ps'
            case 'longPassSuccess' :  return 'ps'
            case 'mediumPassSuccess' :  return 'ps'
            case 'shortPassSuccess' :  return 'ps'
            case 'passFCaDeg' :  return 'ps'
            case 'transversePassSuccess' :  return 'ps'
            case 'passBCaDeg' :  return 'ps'
            case 'crosAcc' :  return 'ps'
            case 'controlUnderPressure' :  return 'ps'
            case 'chalgWon' :  return 'df'
            case 'airChalgWon' :  return 'df'
            case 'tackleSuccess' :  return 'df'
            case 'intercept' :  return 'df'
            case 'cutOff' :  return 'df'
            case 'ballRecoverie' :  return 'df'
            case 'blockingShoot' :  return 'df'
            case 'ballMiss' :  return 'df'
            case 'foul' :  return 'df'
            case 'foulSuffered' :  return 'df'
            case 'yellowCard' :  return 'df'
            case 'redCard' :  return 'df'
            case 'goalConceded' :  return 'gk'
            case 'catchh' :  return 'gk'
            case 'punch' :  return 'gk'
            case 'goalkeeperSave' :  return 'gk'
            case 'goalKick' :  return 'gk'
            case 'goalKickSuccess' :  return 'gk'
            case 'airClearances' :  return 'gk'
            case 'airClearancesSuccess' :  return 'gk'
            default: return '';
        }
    }

</script>

<script>
    var chl_ast;  var ch_ast;  var chr_ast;  var cl_ast;  var cr_ast;  var hl_ast;  var hc_ast;  var hr_ast;  var ll_ast;  var lc_ast;  var lr_ast = 0;
    var chl_goal; var ch_goal; var chr_goal; var cl_goal; var cr_goal; var hl_goal; var hc_goal; var hr_goal; var ll_goal; var lc_goal; var lr_goal = 0;

    function getShootData(){
        var formData = new FormData();
        formData.append('MEET_YEAR', '2026')
        formData.append('MEET_SEQ', '2')
        formData.append('GAME_ID', '1')
        formData.append('homeTeam', 'K41')
        formData.append('awayTeam', 'K32')

        $.ajax({
            url: "/api/ddf/match/getShootData.do",
            type: "POST",
            data: formData,
            enctype: "multipart/form-data",
            cache: false,
            contentType: false,
            processData: false,
            success: function (res) {
                if(res.data.shootEvent.length != 0){
                    writeScoreDesc('H', res.data.shootEventH)
                    writeScoreDesc('A', res.data.shootEventA)
                }
            },
            error: function (request, status, error) {
                alert("code:" + request.status + "\n" + "message:" + request.responseText + "\n" + "error:" + error);
            }
        });
    }
    function writeScoreDesc(homeType, obj){
        var html = '';
        var playerShootInfo = '';

        for(var i=0; i<obj.length; i++) {
            var dto = obj[i];
            if(dto.expected_GOAL != null){
                playerShootInfo += `<span style="display: none;" id="expected_`+dto.player_ID+`">`
                playerShootInfo +=     dto.expected_GOAL
                playerShootInfo += `</span>`
            }
            playerShootInfo += `    <span style="display: none;" id="backNo_`+dto.player_ID+`">`
            playerShootInfo +=         dto.back_NO
            playerShootInfo += `    </span>`
            playerShootInfo += `    <span style="display: none;" id="teamId_`+dto.player_ID+`">`
            playerShootInfo +=         dto.team_ID
            playerShootInfo += `    </span>`
            $(".playerShootInfo").append(playerShootInfo);

            if(dto.type_DETAIL_CD == 'GL') {
                if (dto.own_GOAL_CODE == 'N') {
                    html += `<li>`
                    html += `    <input type="checkbox" class="scoreDescSeq scoreChkbox`+homeType+`" id="chk`+dto.seq+`" value="`+dto.seq+`">`
                    html += `    <label for="chk`+dto.seq+`">`
                    html += `        <div>`
                    html += `            <p class="font-red">득점 (`+dto.shot_GOALPOST_SITE+`)</p>`
                    html += `            <div>`
                    html += `                <p>`+dto.player_NAME + '('+dto.back_NO+')'+ ' ' + '_ ' + dto.min_TIME +  `분 ` + dto.sec_TIME + `초</p>`
                    html += `            </div>`
                    html += `        </div>`
                    html += `    </label>`
                    html += `</li>`
                }
            }
            else if(dto.type_DETAIL_CD == 'AST'){
                html += `<li>`
                html += `    <input type="checkbox" class="scoreDescSeq scoreChkbox`+homeType+`" id="chk`+dto.seq+`" value="`+dto.seq+`">`
                html += `    <label for="chk`+dto.seq+`">`
                html += `        <div>`
                html += `            <p class="font-green">유효슈팅 (`+dto.shot_GOALPOST_SITE+`)</p>`
                html += `            <div>`
                html += `                <p>`+dto.player_NAME + '('+dto.back_NO+')'+ ' ' + '_ ' + dto.min_TIME +  `분 ` + dto.sec_TIME + `초</p>`
                html += `            </div>`
                html += `        </div>`
                html += `    </label>`
                html += `</li>`
            }
            else if(dto.type_DETAIL_CD == 'BT'){
                html += `<li>`
                html += `    <input type="checkbox" class="scoreDescSeq scoreChkbox`+homeType+`" id="chk`+dto.seq+`" value="`+dto.seq+`">`
                html += `    <label for="chk`+dto.seq+`">`
                html += `        <div>`
                html += `            <p>막힌슈팅</p>`
                html += `            <div>`
                html += `                <p>`+dto.player_NAME + '('+dto.back_NO+')'+ ' ' + '_ ' + dto.min_TIME +  `분 ` + dto.sec_TIME + `초</p>`
                html += `            </div>`
                html += `        </div>`
                html += `    </label>`
                html += `</li>`
            }
            else{

            }
        }

        if(homeType == 'H'){ // home
            $(".scoreDescH").empty();
            $(".scoreDescH").append(html);
        }
        else{ // away
            $(".scoreDescA").empty();
            $(".scoreDescA").append(html);
        }

        // 개별 항목
        $(".scoreDescSeq").off("click").on("click", function() {
            if ($(this).prop('checked')) {
                $(this).closest('li').addClass('active');
            } else {
                $(this).closest('li').removeClass('active');
            }
            getShootDataSelected();
        });

        // 홈어웨이 전체
        $("#checkHome").off("click").on("click", function() {
            $('.scoreChkboxH').prop('checked', this.checked);
            getShootDataSelected();
        });
        $("#checkAway").off("click").on("click", function() {
            $('.scoreChkboxA').prop('checked', this.checked);
            getShootDataSelected();
        });

        // 체크박스 상태 활성화
        $('.scoreChkboxH').on('click', function() {
            if ($('.scoreChkboxH:checked').length === $('.scoreChkboxH').length) {
                $('#checkHome').prop('checked', true);
            } else {
                $('#checkHome').prop('checked', false);
            }
        });
        $('.scoreChkboxA').on('click', function() {
            if ($('.scoreChkboxA:checked').length === $('.scoreChkboxA').length) {
                $('#checkAway').prop('checked', true);
            } else {
                $('#checkAway').prop('checked', false);
            }
        });

    }

    function drawShoot(obj){
        var shootCanvas = document.getElementById("shootCanvas");
        var canvasWidth = shootCanvas.width;
        var canvasHeight = shootCanvas.height;

        shootCanvas.width = canvasWidth;
        var ctx = shootCanvas.getContext("2d");
        ctx.lineWidth = 3

        var chkHomeAway = 'home'
        for(var i=0; i<obj.length; i++) {
            var dto = obj[i];

            if(dto.team_ID == 'K41'){
                ctx.strokeStyle = getTeamColor('K41')
                chkHomeAway = 'home'
            }
            else{
                ctx.strokeStyle = getTeamColor('K32')
                chkHomeAway = 'away'
            }
            var fromx = parseFloat(dto.start_POINT_X) * canvasWidth / 100;
            var fromy = parseFloat(dto.start_POINT_Y) * canvasHeight / 100;
            var tox = dto.end_POINT_X ? parseFloat(dto.end_POINT_X) * canvasWidth / 100 : null;
            var toy = dto.end_POINT_Y ? parseFloat(dto.end_POINT_Y) * canvasHeight / 100 : null;

            if (attackDirection > 0){ // 공격방향이 정방향
                if(dto.period_ID == 1){ // 전반은 좌표 그대로

                }
                else{ // 후반은 좌표 역으로
                    fromx = canvasWidth - fromx
                    tox = canvasWidth - tox
                    fromy = canvasHeight - fromy
                    toy = canvasHeight - toy
                }
            }
            else{ // 공격방향이 역방향.
                if(dto.period_ID == 1){ // 전반 좌표를 거꾸로
                    fromx = canvasWidth - fromx
                    tox = canvasWidth - tox
                    fromy = canvasHeight - fromy
                    toy = canvasHeight - toy
                }
                else{ // 후반은그대로

                }
            }

            ctx.beginPath();
            canvas_drawShoot(ctx, fromx, fromy, tox, toy, dto.player_ID, dto.type_DETAIL_CD);
        }
    }
    function canvas_drawShoot(context, fromx, fromy, tox, toy, playerId, shootType) {
        fromx = parseFloat(fromx);
        fromy = parseFloat(fromy);

        if (shootType === 'GL' || shootType === 'AST') {
            if( shootType === 'AST'){
                context.setLineDash([1, 5]);
                context.beginPath();
                context.moveTo(fromx, fromy);
                context.lineTo(tox, toy);
                context.stroke();
                context.setLineDash([])
            }
            else{
                context.beginPath();
                context.moveTo(fromx, fromy);
                context.lineTo(tox, toy);
                context.stroke();
            }
            drawArrowHead(context, fromx, fromy, tox, toy); // 화살표 추가
            drawCircleAndText(context, fromx, fromy, playerId); // 원과 텍스트 그리기
        }
        else if (shootType === 'BT') {
            drawCircleAndText(context, fromx, fromy, playerId); // 원과 텍스트 그리기
            drawXIconAfterCircle(context, fromx, fromy, playerId); // 'X' 아이콘 그리기
            return; // 'bt' 타입은 더 이상 작업이 필요 없음
        }
    }
    function drawCircleAndText(context, fromx, fromy, playerId) {
        var circleRadius = 15;
        context.beginPath();
        context.arc(fromx, fromy, circleRadius, 0, Math.PI * 2);
        context.fillStyle = context.strokeStyle;
        context.fill();
        context.stroke();

        var circleText = $("#backNo_" + playerId).text().trim();
        context.fillStyle = "white";
        context.font = "12px Arial";
        context.textAlign = "center";
        context.textBaseline = "middle";
        context.fillText(circleText, fromx, fromy);

        var txt = $("#expected_" + playerId).text().trim();
        context.fillStyle = "black";
        context.font = "14px Arial";
        context.fillText(txt, fromx, fromy - circleRadius - 5);
    }
    function drawXIconAfterCircle(context, fromx, fromy, playerId) {
        var circleRadius = 15;
        var xOffset = circleRadius * 1.2;
        var yOffset = circleRadius * 0.7;

        var img = new Image(); // 새로운 이미지 객체 생성
        img.src = 'assets/images/ico/ic-shot-bt.svg'; // 이미지 경로 설정
        img.onload = function() {
            context.drawImage(img, fromx + xOffset - img.width / 2, fromy + yOffset - img.height / 2);
        };
    }
    function drawArrowHead(context, fromx, fromy, tox, toy) {
        var headlen = 10; // 화살표 크기
        var angle = Math.atan2(toy - fromy, tox - fromx);

        context.lineWidth=2;
        context.beginPath();
        context.moveTo(tox, toy);
        context.lineTo(tox - headlen * Math.cos(angle - Math.PI / 6), toy - headlen * Math.sin(angle - Math.PI / 6));
        context.moveTo(tox, toy);
        context.lineTo(tox - headlen * Math.cos(angle + Math.PI / 6), toy - headlen * Math.sin(angle + Math.PI / 6));
        context.stroke();
        context.lineWidth=3;
    }

    function getShootDataSelected(){
        resetGoalPostData();

        var seqList = [];
        $(".scoreDescSeq:checked").each(function() {
            var dataValue = $(this).val();
            seqList.push(dataValue);
        });

        if(seqList.length > 0){
            var formData = new FormData();
            formData.append('MEET_YEAR', '2026')
            formData.append('MEET_SEQ', '2')
            formData.append('GAME_ID', '1')
            formData.append('homeTeam', 'K41')
            formData.append('awayTeam', 'K32')
            formData.append('seqList', seqList)

            $.ajax({
                url: "/api/ddf/match/getShootData.do",
                type: "POST",
                data: formData,
                enctype: "multipart/form-data",
                cache: false,
                contentType: false,
                processData: false,
                success: function (res) {
                    if(res.data.shootEvent.length != 0){ // 선택된 항목에 따른 골퍼스트 및 캔버스
                        setGoalPostData('H', res.data.shootEventH)
                        setGoalPostData('A', res.data.shootEventA)
                        drawShoot(res.data.shootEvent)
                    }
                },
                error: function (request, status, error) {
                    alert("code:" + request.status + "\n" + "message:" + request.responseText + "\n" + "error:" + error);
                }
            });
        }
        else{
            var canvas = document.getElementById("shootCanvas");
            var ctx = canvas.getContext("2d");
            ctx.clearRect(0, 0, canvas.width, canvas.height);
        }
    }
    function resetGoalPostData(){
        $('.score-area li').empty();
    }
    function setGoalPostData(homeType, obj){
        chl_ast=0;  ch_ast=0;  chr_ast=0;  cl_ast=0;  cr_ast=0;  hl_ast=0;  hc_ast=0;  hr_ast=0;  ll_ast=0;  lc_ast=0;  lr_ast=0;
        chl_goal=0;  ch_goal=0;  chr_goal=0;  cl_goal=0;  cr_goal=0;  hl_goal=0;  hc_goal=0;  hr_goal=0;  ll_goal=0;  lc_goal=0;  lr_goal=0;

        for(var i=0; i<obj.length; i++) {
            var dto = obj[i];
            var gps = dto.shot_GOALPOST_SITE;
            if (gps != null){
                gps = '(' + gps + ')';
                if(dto.type_DETAIL_CD == 'AST'){
                    switch(dto.shot_GOALPOST_SITE){
                        case 'CHL' : chl_ast++; break;
                        case 'CH'  : ch_ast++;  break;
                        case 'CHR' : chr_ast++; break;
                        case 'CL'  : cl_ast++;  break;
                        case 'CR'  : cr_ast++;  break;
                        case 'HL'  : hl_ast++;  break;
                        case 'HC'  : hc_ast++;  break;
                        case 'HR'  : hr_ast++;  break;
                        case 'LL'  : ll_ast++;  break;
                        case 'LC'  : lc_ast++;  break;
                        case 'LR'  : lr_ast++;  break;
                        default : break;
                    }
                }
                else if(dto.type_DETAIL_CD == 'GL'){
                    switch(dto.shot_GOALPOST_SITE){
                        case 'CHL' : chl_goal++; break;
                        case 'CH'  : ch_goal++;  break;
                        case 'CHR' : chr_goal++; break;
                        case 'CL'  : cl_goal++;  break;
                        case 'CR'  : cr_goal++;  break;
                        case 'HL'  : hl_goal++;  break;
                        case 'HC'  : hc_goal++;  break;
                        case 'HR'  : hr_goal++;  break;
                        case 'LL'  : ll_goal++;  break;
                        case 'LC'  : lc_goal++;  break;
                        case 'LR'  : lr_goal++;  break;
                        default : break;
                    }
                }
                else{ // 'bt'

                }
            }
        }

        if(homeType == 'H'){ // home
            drawShootGoalPostSite(1);
        }
        else{ // away
            drawShootGoalPostSite(0);
        }
    }
    function drawShootGoalPostSite(homeType){
        if( chl_goal != 0  ||  chl_ast != 0 ) {
            var tmpHtml = `<ul>`;
            if( chl_goal != 0 ) {
                tmpHtml += `<li><i class="ico ico-goal"></i><p>`+ chl_goal  + `</p></li>`;
            }
            if( chl_ast != 0 ) {
                tmpHtml += `<li><p>` + chl_ast  + `</p></li>`;
            }
            tmpHtml += `</ul>`;
            if(homeType == 1){
                $(".scoreAreaH .close-high-left").append(tmpHtml);
            }
            else{
                $(".scoreAreaA .close-high-left").append(tmpHtml);
            }

        }
        if( ch_goal  != 0  ||  ch_ast  != 0 ) {
            var tmpHtml = `<ul>`;
            if( ch_goal  != 0 ) {
                tmpHtml += `<li><i class="ico ico-goal"></i><p>`+ ch_goal   + `</p></li>`;
            }
            if( ch_ast  != 0 ) {
                tmpHtml += `<li><p>` + ch_ast   + `</p></li>`;
            }
            tmpHtml += `</ul>`;
            if(homeType == 1){
                $(".scoreAreaH .close-high").append(tmpHtml);
            }
            else{
                $(".scoreAreaA .close-high").append(tmpHtml);
            }
        }
        if( chr_goal != 0  ||  chr_ast != 0 ) {
            var tmpHtml = `<ul>`;
            if( chr_goal != 0 ) {
                tmpHtml += `<li><i class="ico ico-goal"></i><p>`+ chr_goal  + `</p></li>`;
            }
            if( chr_ast != 0 ) {
                tmpHtml += `<li><p>` + chr_ast  + `</p></li>`;
            }
            tmpHtml += `</ul>`;
            if(homeType == 1){
                $(".scoreAreaH .close-high-right").append(tmpHtml);
            }
            else{
                $(".scoreAreaA .close-high-right").append(tmpHtml);
            }
        }
        if( cl_goal  != 0  ||  cl_ast  != 0 ) {
            var tmpHtml = `<ul>`;
            if( cl_goal  != 0 ) {
                tmpHtml += `<li><i class="ico ico-goal"></i><p>`+ cl_goal   + `</p></li>`;
            }
            if( cl_ast  != 0 ) {
                tmpHtml += `<li><p>` + cl_ast   + `</p></li>`;
            }
            tmpHtml += `</ul>`;
            if(homeType == 1){
                $(".scoreAreaH .close-left").append(tmpHtml);
            }
            else{
                $(".scoreAreaA .close-left").append(tmpHtml);
            }
        }
        if( cr_goal  != 0  ||  cr_ast  != 0 ) {
            var tmpHtml = `<ul>`;
            if( cr_goal  != 0 ) {
                tmpHtml += `<li><i class="ico ico-goal"></i><p>`+ cr_goal   + `</p></li>`;
            }
            if( cr_ast  != 0 ) {
                tmpHtml += `<li><p>` + cr_ast   + `</p></li>`;
            }
            tmpHtml += `</ul>`;
            if(homeType == 1){
                $(".scoreAreaH .high-left").append(tmpHtml);
            }
            else{
                $(".scoreAreaA .high-left").append(tmpHtml);
            }
        }
        if( hl_goal  != 0  ||  hl_ast  != 0 ) {
            var tmpHtml = `<ul>`;
            if( hl_goal  != 0 ) {
                tmpHtml += `<li><i class="ico ico-goal"></i><p>`+ hl_goal   + `</p></li>`;
            }
            if( hl_ast  != 0 ) {
                tmpHtml += `<li><p>` + hl_ast   + `</p></li>`;
            }
            tmpHtml += `</ul>`;
            if(homeType == 1){
                $(".scoreAreaH .high-center").append(tmpHtml);
            }
            else{
                $(".scoreAreaA .high-center").append(tmpHtml);
            }
        }
        if( hc_goal  != 0  ||  hc_ast  != 0 ) {
            var tmpHtml = `<ul>`;
            if( hc_goal  != 0 ) {
                tmpHtml += `<li><i class="ico ico-goal"></i><p>`+ hc_goal   + `</p></li>`;
            }
            if( hc_ast  != 0 ) {
                tmpHtml += `<li><p>` + hc_ast   + `</p></li>`;
            }
            tmpHtml += `</ul>`;
            if(homeType == 1){
                $(".scoreAreaH .high-right").append(tmpHtml);
            }
            else{
                $(".scoreAreaA .high-right").append(tmpHtml);
            }
        }
        if( hr_goal  != 0  ||  hr_ast  != 0 ) {
            var tmpHtml = `<ul>`;
            if( hr_goal  != 0 ) {
                tmpHtml += `<li><i class="ico ico-goal"></i><p>`+ hr_goal   + `</p></li>`;
            }
            if( hr_ast  != 0 ) {
                tmpHtml += `<li><p>` + hr_ast   + `</p></li>`;
            }
            tmpHtml += `</ul>`;
            if(homeType == 1){
                $(".scoreAreaH .close-right").append(tmpHtml);
            }
            else{
                $(".scoreAreaA .close-right").append(tmpHtml);
            }
        }
        if( ll_goal  != 0  ||  ll_ast  != 0 ) {
            var tmpHtml = `<ul>`;
            if( ll_goal  != 0 ) {
                tmpHtml += `<li><i class="ico ico-goal"></i><p>`+ ll_goal   + `</p></li>`;
            }
            if( ll_ast  != 0 ) {
                tmpHtml += `<li><p>` + ll_ast   + `</p></li>`;
            }
            tmpHtml += `</ul>`;
            if(homeType == 1){
                $(".scoreAreaH .low-left").append(tmpHtml);
            }
            else{
                $(".scoreAreaA .low-left").append(tmpHtml);
            }
        }
        if( lc_goal  != 0  ||  lc_ast  != 0 ) {
            var tmpHtml = `<ul>`;
            if( lc_goal  != 0 ) {
                tmpHtml += `<li><i class="ico ico-goal"></i><p>`+ lc_goal   + `</p></li>`;
            }
            if( lc_ast  != 0 ) {
                tmpHtml += `<li><p>` + lc_ast   + `</p></li>`;
            }
            tmpHtml += `</ul>`;
            if(homeType == 1){
                $(".scoreAreaH .low-center").append(tmpHtml);
            }
            else{
                $(".scoreAreaA .low-center").append(tmpHtml);
            }
        }
        if( lr_goal  != 0  ||  lr_ast  != 0 ) {
            var tmpHtml = `<ul>`;
            if( lr_goal  != 0 ) {
                tmpHtml += `<li><i class="ico ico-goal"></i><p>`+ lr_goal   + `</p></li>`;
            }
            if( lr_ast  != 0 ) {
                tmpHtml += `<li><p>` + lr_ast   + `</p></li>`;
            }
            tmpHtml += `</ul>`;
            if(homeType == 1){
                $(".scoreAreaH .low-right").append(tmpHtml);
            }
            else{
                $(".scoreAreaA .low-right").append(tmpHtml);
            }
        }
    }
</script>

<script>
    function showMatrix(homeFlag) {
        if (homeFlag == 1) {
            $(".awayMatrix").css('display','none')
            $(".homeMatrix").show()

            $(".passMatrixHome").addClass('active')
            $(".passMatrixAway").removeClass('active')
        }
        else{
            $(".homeMatrix").css('display','none')
            $(".awayMatrix").show()

            $(".passMatrixAway").addClass('active')
            $(".passMatrixHome").removeClass('active')
        }
    }


    function showMatrix(homeFlag) {
        if (homeFlag == 1) {
            $(".awayMatrix").css('display','none')
            $(".homeMatrix").show()

            $(".passMatrixHome").addClass('active')
            $(".passMatrixAway").removeClass('active')
        }
        else{
            $(".homeMatrix").css('display','none')
            $(".awayMatrix").show()

            $(".passMatrixAway").addClass('active')
            $(".passMatrixHome").removeClass('active')
        }
    }

    function getPassData(){
        var formData = new FormData();
        formData.append('year', '2026')
        formData.append('meetSeq', '2')
        formData.append('gameId', '1')
        formData.append('homeTeam', 'K41')
        formData.append('awayTeam', 'K32')

        $.ajax({
            url: "/api/ddf/match/getPassData.do",
            type: "POST",
            data: formData,
            enctype: "multipart/form-data",
            cache: false,
            contentType: false,
            processData: false,
            success: function (res) {
                // Home 팀 매트릭스 생성
                createMatrix(res.data.passHome, res.data.passCntMaxH, 'K41', '.homeMatrix');

                // Away 팀 매트릭스 생성
                createMatrix(res.data.passAway, res.data.passCntMaxA, 'K32', '.awayMatrix');
            },
            error: function (request, status, error) {
                alert("code:" + request.status + "\n" + "message:" + request.responseText + "\n" + "error:" + error);
            }
        });
    }

    // 매트릭스 생성 함수
    function createMatrix(passData, passCntMax, team, selector) {
        var html = '<table class="' + selector.substr(1) + '">';

        // colgroup 생성
        html += '<colgroup>';
        html += '<col style="width: 5%;">';
        html += '<col style="width: 7%;">';
        for (var i = 0; i < passData.playerNames.length; i++) {
            html += '<col style="width: ' + (88 / passData.playerNames.length) + '%;">';
        }
        html += '</colgroup>';

        // thead 생성
        html += '<thead>';
        html += '<tr>';
        html += '<th colspan="2" rowspan="2"><i class="ic-emblem ' + team + '"></i></th>';
        passData.playerIds.forEach(function(playerId) {
            html += '<th>' + (passData.positionMap[playerId] || '') + '</th>';
        });
        html += '</tr>';
        html += '<tr>';
        passData.playerNames.forEach(function(name) {
            html += '<th><p>' + name + '</p></th>';
        });
        html += '</tr>';
        html += '</thead>';

        // tbody 생성
        html += '<tbody>';
        passData.playerIds.forEach(function(playerId, rowIndex) {
            html += '<tr>';
            html += '<td>' + (passData.positionMap[playerId] || '') + '</td>';
            html += '<td>' + passData.playerNames[rowIndex] + '</td>';
            passData.playerIds.forEach(function(targetId) {
                var passCount = passData.passMatrix[playerId] && passData.passMatrix[playerId][targetId] != null
                    ? passData.passMatrix[playerId][targetId]
                    : 0;
                var level = passCount !== 0 ? Math.floor(passCount / passCntMax * 16) : 0;
                html += '<td class="level' + level + '">' + passCount + '</td>';
            });
            html += '</tr>';
        });
        html += '</tbody>';

        html += '</table>';

        $(selector).html(html);
    }
</script>



            
        </div>

    </div>
</div>


  	




