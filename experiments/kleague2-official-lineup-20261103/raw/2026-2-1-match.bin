<style>
    .box > table > thead > tr > th, td {font-size: 10px;}
    .chart-container {
        position: relative;
        width: 100%;
        height: 200px; /* 높이를 조금 늘렸습니다 */
        margin-top: 20px; /* 상단 여백 추가 */
    }
    .chart-background {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
    }
    .win-section, .draw-section, .lose-section {
        position: absolute;
        width: 100%;
        height: 33.33%;
    }
    .win-section {
        top: 0;
        background-color: rgba(26, 26, 26, 0.05); /* 투명도를 낮췄습니다 */
    }
    .draw-section {
        top: 33.33%;
        background-color: rgba(77, 77, 77, 0.05); /* 투명도를 낮췄습니다 */
    }
    .lose-section {
        top: 66.66%;
        background-color: rgba(128, 128, 128, 0.05); /* 투명도를 낮췄습니다 */
    }
    .section-label {
        position: absolute;
        left: 10px;
        font-size: 14px; /* 글자 크기를 조금 줄였습니다 */
        font-weight: bold;
        color: #333; /* 글자 색상을 어두운 회색으로 변경했습니다 */
        z-index: 1;
    }
    .label-win { top: 10%; }
    .label-draw { top: 43%; }
    .label-lose { bottom: 10%; }

    /* 차트 캔버스에 대한 새로운 스타일 */
    .combinedLineChartA, .combinedLineChartT, .combinedLineChartF {
        position: relative;
        z-index: 2; /* 배경보다 위에 오도록 z-index 설정 */
    }
</style>
<script>
    function getTeamColor(teamId){
        if(teamId == 'K01') return '#0A68DD';
        else if(teamId == 'K02') return '#E5373A';
        else if(teamId == 'K03') return '#E85548';
        else if(teamId == 'K04') return '#FF6D1A';
        else if(teamId == 'K05') return '#058445';
        else if(teamId == 'K06') return '#FF3B26';
        else if(teamId == 'K07') return '#FFE100';
        else if(teamId == 'K08') return '#413E3F';
        else if(teamId == 'K09') return '#BF9A10';
        else if(teamId == 'K10') return '#3D8C7E';
        else if(teamId == 'K17') return '#91CAED';
        else if(teamId == 'K18') return '#0A84D7';
        else if(teamId == 'K20') return '#6A1F14';
        else if(teamId == 'K21') return '#FF6023';
        else if(teamId == 'K22') return '#C3072D';
        else if(teamId == 'K26') return '#A11C17';
        else if(teamId == 'K27') return '#492678';
        else if(teamId == 'K29') return '#135693';
        else if(teamId == 'K31') return '#C6976A';
        else if(teamId == 'K32') return '#00A887';
        else if(teamId == 'K34') return '#15316F';
        else if(teamId == 'K35') return '#C8A973';
        else if(teamId == 'K36') return '#2A5154';
        else if(teamId == 'K37') return '#273079';
        else if(teamId == 'K38') return '#B8E5FF';
        else if(teamId == 'K39') return '#E8551E';
        else{ return '';}
    }
    // barChart
    document.addEventListener('DOMContentLoaded', function() {
        var barCanvasA = document.querySelector('#barChartAll');
        var barCanvasF = document.querySelector('#barChartFive');
        var barCanvasT = document.querySelector('#barChartTen');

        var barCtxA = barCanvasA.getContext('2d'); // getContext 호출
        var barCtxF = barCanvasF.getContext('2d'); // getContext 호출
        var barCtxT = barCanvasT.getContext('2d'); // getContext 호출

        const backgroundColors = [getTeamColor(`K41`), getTeamColor(`K32`), 'gray']
        const labelsA = [`김해FC2008 0승`,`안산 그리너스 0승`,`무승부 0`];
        const dataA = [0, 0, 0];
        const filteredDataA = dataA.map((value, index) => ({ value, label: labelsA[index], color: backgroundColors[index] })).filter(item => item.value !== 0); // 값이 0이 아닌 항목만 남기기
        const filteredLabelsA = filteredDataA.map(item => item.label);
        const filteredValuesA = filteredDataA.map(item => item.value);
        const filteredColorsA = filteredDataA.map(item => item.color);

        new Chart(barCtxA, {
            type: 'bar',
            data: {
                labels: filteredLabelsA,
                datasets: [{
                    data: filteredValuesA,
                    backgroundColor: filteredColorsA,
                    barThickness: 80
                }]
            },
            options: {
                responsive: true,
                layout: {
                    padding: {
                        right: 80, left: 80,
                    }
                },
                plugins: {
                    tooltip: {
                        enabled: false
                    },
                    legend: {
                        display: false
                    }
                },
                scales: {
                    x: {
                        display: true,
                        grid: {
                            display: false
                        }
                    },
                    y: {
                        display: false
                    },
                }
            },
            plugins: [{
                id: 'customBarText',
                afterDraw: (chart) => {
                    const barCtxA = chart.ctx;
                    chart.data.datasets[0].data.forEach((value, index) => {
                        const meta = chart.getDatasetMeta(0);
                        const xPos = meta.data[index].x;
                        const yPos = meta.data[index].y;
                        const barHeight = meta.data[index].height;

                        barCtxA.save();
                        barCtxA.textAlign = 'center';
                        barCtxA.textBaseline = 'middle';
                        barCtxA.font = 'bold 13px Roboto';
                        barCtxA.fillStyle = 'white';

                        const total = chart.data.datasets[0].data.reduce((a, b) => a + b, 0);
                        const percentage = ((value / total) * 100).toFixed(1);
                        const label = chart.data.labels[index];
                        const unit = label.includes('무승부') ? '무' : '승';

                        barCtxA.fillText(value+unit, xPos, yPos + barHeight / 2 - 8);
                        barCtxA.fillText(percentage+`%`, xPos, yPos + barHeight / 2 + 8);

                        barCtxA.restore();
                    });
                }
            }]
        });

        const labelsF = [`김해FC2008 0승`,`안산 그리너스 0승`,`무승부 0`];
        const dataF = [0, 0, 0];
        const filteredDataF = dataF.map((value, index) => ({ value, label: labelsF[index], color: backgroundColors[index] })).filter(item => item.value !== 0); // 값이 0이 아닌 항목만 남기기
        const filteredLabelsF = filteredDataF.map(item => item.label);
        const filteredValuesF = filteredDataF.map(item => item.value);
        const filteredColorsF = filteredDataF.map(item => item.color);

        new Chart(barCtxF, {
            type: 'bar',
            data: {
                labels: filteredLabelsF,
                datasets: [{
                    data: filteredValuesF,
                    backgroundColor: filteredColorsF,
                    barThickness: 80
                }]
            },
            // 동일
            options: {
                responsive: true,
                layout: {
                    padding: {
                        right: 80, left: 80,
                    }
                },
                plugins: {
                    tooltip: {
                        enabled: false
                    },
                    legend: {
                        display: false
                    }
                },
                scales: {
                    x: {
                        display: true,
                        grid: {
                            display: false
                        }
                    },
                    y: {
                        display: false
                    },
                }
            },
            plugins: [{
                id: 'customBarText',
                afterDraw: (chart) => {
                    const barCtxF = chart.ctx;
                    chart.data.datasets[0].data.forEach((value, index) => {
                        const meta = chart.getDatasetMeta(0);
                        const xPos = meta.data[index].x;
                        const yPos = meta.data[index].y;
                        const barHeight = meta.data[index].height;

                        barCtxF.save();
                        barCtxF.textAlign = 'center';
                        barCtxF.textBaseline = 'middle';
                        barCtxF.font = 'bold 13px Roboto';
                        barCtxF.fillStyle = 'white';

                        const total = chart.data.datasets[0].data.reduce((a, b) => a + b, 0);
                        const percentage = ((value / total) * 100).toFixed(1);
                        const label = chart.data.labels[index];
                        const unit = label.includes('무승부') ? '무' : '승';

                        barCtxF.fillText(value+unit, xPos, yPos + barHeight / 2 - 8);
                        barCtxF.fillText(percentage+`%`, xPos, yPos + barHeight / 2 + 8);

                        barCtxF.restore();
                    });
                }
            }]
        });


        const labelsT = [`김해FC2008 0승`,`안산 그리너스 0승`,`무승부 0`];
        const dataT = [0, 0, 0];
        const filteredDataT = dataT.map((value, index) => ({ value, label: labelsT[index], color: backgroundColors[index] })).filter(item => item.value !== 0); // 값이 0이 아닌 항목만 남기기
        const filteredLabelsT = filteredDataT.map(item => item.label);
        const filteredValuesT = filteredDataT.map(item => item.value);
        const filteredColorsT = filteredDataT.map(item => item.color);

        new Chart(barCtxT, {
            type: 'bar',
            data: {
                labels: filteredLabelsT,
                datasets: [{
                    data: filteredValuesT,
                    backgroundColor: filteredColorsT,
                    barThickness: 80
                }]
            },
            // 동일
            options: {
                responsive: true,
                layout: {
                    padding: {
                        right: 80, left: 80,
                    }
                },
                plugins: {
                    tooltip: {
                        enabled: false
                    },
                    legend: {
                        display: false
                    }
                },
                scales: {
                    x: {
                        display: true,
                        grid: {
                            display: false
                        }
                    },
                    y: {
                        display: false
                    },
                }
            },
            plugins: [{
                id: 'customBarText',
                afterDraw: (chart) => {
                    const barCtxT = chart.ctx;
                    chart.data.datasets[0].data.forEach((value, index) => {
                        const meta = chart.getDatasetMeta(0);
                        const xPos = meta.data[index].x;
                        const yPos = meta.data[index].y;
                        const barHeight = meta.data[index].height;

                        barCtxT.save();
                        barCtxT.textAlign = 'center';
                        barCtxT.textBaseline = 'middle';
                        barCtxT.font = 'bold 13px Roboto';
                        barCtxT.fillStyle = 'white';

                        const total = chart.data.datasets[0].data.reduce((a, b) => a + b, 0);
                        const percentage = ((value / total) * 100).toFixed(1);
                        const label = chart.data.labels[index];
                        const unit = label.includes('무승부') ? '무' : '승';

                        barCtxT.fillText(value+unit, xPos, yPos + barHeight / 2 - 8);
                        barCtxT.fillText(percentage+`%`, xPos, yPos + barHeight / 2 + 8);

                        barCtxT.restore();
                    });
                }
            }]
        });

    });

    // linechart
    const results = [];
    const reversedResults = [];
    const tooltipData = Array.from(document.querySelectorAll('.annotationBoxALi')).map(el => el.textContent);

    const resultsF = results.slice(0,5)
    const reversedResultsF = reversedResults.slice(0,5)
    const resultsT = results.slice(0,10)
    const reversedResultsT = reversedResults.slice(0,10)

    results.reverse()
    reversedResults.reverse()

    resultsF.reverse()
    reversedResultsF.reverse()
    resultsT.reverse()
    reversedResultsT.reverse()

    document.addEventListener('DOMContentLoaded', function() {
        var lineCanvas = document.querySelector('.combinedLineChartA');
        var lineCtx = lineCanvas.getContext('2d');
        let lineChart;

        function initChart() {
            lineChart = new Chart(lineCtx, {
                type: 'line',
                data: {
                    labels: Array.from({ length: results.length }, (_, i) => ``),
                    datasets: [{
                        label: 'Results',
                        data: results,
                        backgroundColor: 'rgba(0, 0, 255, 0.1)',
                        borderColor: getTeamColor(`K41`),
                        borderWidth: 2,
                        pointRadius: 5,
                        pointBackgroundColor: getTeamColor(`K41`),
                        pointBorderColor: getTeamColor(`K41`)
                    }, {
                        label: 'Reverse Results',
                        data: reversedResults,
                        backgroundColor: 'rgba(255, 0, 0, 0.1)',
                        borderColor: getTeamColor(`K32`),
                        borderWidth: 2,
                        pointRadius: 5,
                        pointBackgroundColor: getTeamColor(`K32`),
                        pointBorderColor: getTeamColor(`K32`)
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    layout: {
                        padding: {
                            left: 100,
                            right: 100
                        }
                    },
                    scales: {
                        x: { display: false },
                        y: { display: false, min: 0, max: 6 }
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            enabled: true,
                            mode: 'index',
                            intersect: false,
                            callbacks: {
                                label: function(context) {
                                    if (context.datasetIndex === 0) {
                                        const dataIndex = results.length - 1 - context.dataIndex;
                                        return tooltipData[dataIndex] || '';
                                    }
                                    return null;
                                }
                            },
                            displayColors: false
                        },
                        datalabels: { display: false }
                    }
                },
            });
        }

        initChart();
    });
    document.addEventListener('DOMContentLoaded', function() {
        var lineCanvasF = document.querySelector('.combinedLineChartF');
        var lineCtxF = lineCanvasF.getContext('2d');
        let lineChartF;

        function initChartF() {
            lineChartF = new Chart(lineCtxF, {
                type: 'line',
                data: {
                    labels: Array.from({ length: 0 }, (_, i) => ``),
                    datasets: [{
                        label: 'Results',
                        data: resultsF,
                        backgroundColor: 'rgba(0, 0, 255, 0.1)',
                        borderColor: getTeamColor(`K41`),
                        borderWidth: 2,
                        pointRadius: 5,
                        pointBackgroundColor: getTeamColor(`K41`),
                        pointBorderColor: getTeamColor(`K41`)
                    }, {
                        label: 'Reverse Results',
                        data: reversedResultsF,
                        backgroundColor: 'rgba(255, 0, 0, 0.1)',
                        borderColor: getTeamColor(`K32`),
                        borderWidth: 2,
                        pointRadius: 5,
                        pointBackgroundColor: getTeamColor(`K32`),
                        pointBorderColor: getTeamColor(`K32`)
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    layout: {
                        padding: {
                            left: 100,
                            right: 100
                        }
                    },
                    scales: {
                        x: { display: false },
                        y: { display: false, min: 0, max: 6 }
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            enabled: true,
                            mode: 'index',
                            intersect: false,
                            callbacks: {
                                label: function(context) {
                                    if (context.datasetIndex === 0) {
                                        const dataIndex = resultsF.length - 1 - context.dataIndex;
                                        return tooltipData[dataIndex] || '';
                                    }
                                    return null;
                                }
                            },
                            displayColors: false
                        },
                        datalabels: { display: false }
                    }
                }
            });
        }

        initChartF();
    });
    document.addEventListener('DOMContentLoaded', function() {
        var lineCanvasT = document.querySelector('.combinedLineChartT');
        var lineCtxT = lineCanvasT.getContext('2d');
        let lineChartT;

        function initChartT() {
            lineChartT = new Chart(lineCtxT, {
                type: 'line',
                data: {
                    labels: Array.from({ length: 0 }, (_, i) => ``),
                    datasets: [{
                        label: 'Results',
                        data: resultsT,
                        backgroundColor: 'rgba(0, 0, 255, 0.1)',
                        borderColor: getTeamColor(`K41`),
                        borderWidth: 2,
                        pointRadius: 5,
                        pointBackgroundColor: getTeamColor(`K41`),
                        pointBorderColor: getTeamColor(`K41`)
                    }, {
                        label: 'Reverse Results',
                        data: reversedResultsT,
                        backgroundColor: 'rgba(255, 0, 0, 0.1)',
                        borderColor: getTeamColor(`K32`),
                        borderWidth: 2,
                        pointRadius: 5,
                        pointBackgroundColor: getTeamColor(`K32`),
                        pointBorderColor: getTeamColor(`K32`)
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    layout: {
                        padding: {
                            left: 100,
                            right: 100
                        }
                    },
                    scales: {
                        x: { display: false },
                        y: { display: false, min: 0, max: 6 }
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            enabled: true,
                            mode: 'index',
                            intersect: false,
                            callbacks: {
                                label: function(context) {
                                    if (context.datasetIndex === 0) {
                                        const dataIndex = resultsT.length - 1 - context.dataIndex;
                                        return tooltipData[dataIndex] || '';
                                    }
                                    return null;
                                }
                            },
                            displayColors: false
                        },
                        datalabels: { display: false }
                    }
                }
            });
        }

        initChartT();
    });



</script>


            
                
                




