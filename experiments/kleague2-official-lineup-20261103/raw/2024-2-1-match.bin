    <div class="cont-box">
        <h3 class="title-box">타임라인</h3>
        <ul class="timeline-new" id="timeline">
        </ul>
    </div>

</div>
<script>
    // 주요기록
    function updateMatchRecord() {
        var keyArr = [
            ['점유율 (%)', 'possession', 1],
            ['슈팅', 'attempts', 2],
            ['유효슈팅', 'onTarget', 2],
            ['파울', 'fouls', 2],
            ['경고', 'yellowCards', 2],
            ['퇴장', 'redCards', 2],
            ['퇴장(경고누적)', 'doubleYellowCards', 2],
            ['코너킥', 'corners', 2],
            ['프리킥', 'freeKicks', 2],
            ['오프사이드', 'offsides', 2]
        ]
        $.ajax({
            type: "POST",
            url: "/api/ddf/match/matchRecord.do",
            data: {
                "year": '2024',
                "meetSeq": '2',
                "gameId": '1'
            },
            success: function (res) {
                if(res.resultCode != 200) {
                    console.log("경기정보 업데이트 실패 [" + res.resultCode + "]");
                    return;
                }
                $("#matchRecordArea").empty();

                // 패스성공률, 평점

                if(res.data.home != null){
                    for(let i = 0; i < keyArr.length; i++) {
                        var html = `<div>`
                        html += `<p>`+keyArr[i][0]+`</p>`
                        html += `<ul>`
                        html += `<li class="home K32"><div><span style="width: `+res.data.home[keyArr[i][1]] * keyArr[i][2]+`%"></span></div><p>`+res.data.home[keyArr[i][1]]+`</p></li>`
                        html += `<li class="away K20"><div><span style="width: `+res.data.away[keyArr[i][1]] * keyArr[i][2]+`%"></span></div><p>`+res.data.away[keyArr[i][1]]+`</p></li>`
                        html += `</ul>`
                        html += `</div>`
                        $("#matchRecordArea").append(html);
                    }
                    updatePossession();
                }

            },
            error: function (err) {
                console.log("경기정보 업데이트 실패");
                console.log(err);
            }
        });
    }

    function updatePossession() {
        var firstHalfKeyArr = [
            ['15', 'first_15'],
            ['30', 'first_30'],
            ['45', 'first_45']
        ]
        var secondHalfKeyArr = [
            ['15', 'second_15'],
            ['30', 'second_30'],
            ['45', 'second_45']
        ]
        var keys = [[firstHalfKeyArr, '#firstPossessionArea'], [secondHalfKeyArr, '#secondPossessionArea']];

        $.ajax({
            type: "POST",
            url: "/api/ddf/match/possession.do",
            data: {
                "year": '2024',
                "meetSeq": '2',
                "gameId": '1'
            },
            success: function (res) {
                if(res.resultCode != 200) {
                    console.log("볼 점유율 업데이트 실패 [" + res.resultCode + "]");
                    return;
                }
                else{
                    for(let j = 0; j < keys.length; j++) {
                        var keyArr = keys[j][0];
                        for (let i = 0; i < keyArr.length; i++) {
                            var row = `<div class="ball-time">
                                    <p>`+possessionTxt(keyArr[i][1])+`</p>
                                    <ul>
                                        <li class="home K32"><div><span style="width: `+ res.data.home[keyArr[i][1]] +`%"></span></div><p>`+ res.data.home[keyArr[i][1]] +`%</p></li>
                                        <li class="away K20"><div><span style="width: `+ res.data.away[keyArr[i][1]] +`%"></span></div><p>`+ res.data.away[keyArr[i][1]] +`%</p></li>
                                    </ul>
                                </div>`
                            $("#matchRecordArea").append(row);
                        }
                    }
                }

            },
            error: function (err) {
                console.log("볼 점유율 업데이트 실패");
                console.log(err);
            }
        });
    }
    function possessionTxt(keyArr){
        if(keyArr == 'first_15'){return '전반 15분'}
        else if(keyArr == 'first_30'){return '전반 30분'}
        else if(keyArr == 'first_45'){return '전반 45분'}
        else if(keyArr == 'second_15'){return '후반 15분'}
        else if(keyArr == 'second_30'){return '후반 30분'}
        else if(keyArr == 'second_45'){return '후반 45분'}
        else{

        }
    }

    //타임라인
    function updateTimeline(firstHalf, secondHalf, EfirstHalf, EsecondHalf) {
        var eventIconMap = {
            '경고':'ic-warn1',
            '경고누적':'ic-warn2',
            '퇴장':'ic-exit',
            '교체':'ic-change',
            '득점':'ic-ball',
            '자책골':'ic-ball2',
            '도움':'ic-assist'
        }
        var eventNameLang = {
            '교체': '교체',
            '경고': '경고',
            '퇴장': '퇴장',
            '득점': '득점',
            '자책골': '자책골',
            '전반시작': '전반시작',
            '파울': '파울',
            '유효슈팅': '유효슈팅',
            '전반종료': '전반종료',
            '후반시작': '후반시작',
            '후반종료': '후반종료',
            '경기종료': '경기종료',
            '경고누적': '퇴장<br>(경고누적)',
            '도움':'도움'
        };
        const tagId = '#timeline';
        var timelines = [firstHalf, secondHalf, EfirstHalf, EsecondHalf];
        $(tagId).empty();

        var keyEventHomeType = [];
        var keyEventName = [];
        var keyEventTime = [];
        var keyEventPlayer = [];

        for(let j = 0; j < timelines.length; j++) {
            var timeline = timelines[j];
            for(let i=0; i < timeline.length; i++) {
                var eventName = timeline[i].eventName;
                var isHome = timeline[i].homeOrAway == "HOME" ? true : false;
                if (eventName == '파울') { // 파울은 제외
                    continue;
                }
                else if (eventName.endsWith('시작') || eventName.endsWith('종료')) {
                    var row = '';
                    row += '<li class="time">'
                    row += '<p style="font-size: 14px;">' + (parseInt(timeline[i].timeMin) > 45 ? ('45+'+(parseInt(timeline[i].timeMin)-45).toString()) : parseInt(timeline[i].timeMin)) + `'</p>`;
                    row += '<div><span>'
                    row += eventNameLang[eventName]
                    row += '</div></span>'
                    row += '</li></ul>'

                    $(tagId).append(row);
                    continue;
                }
                else if (eventIconMap[eventName] != null) { // 주요이벤트
                    var row = '';
                    if (isHome) {
                        row += '<li class="home K32 '
                        if(eventName == '득점'){
                            row += ' goal'
                        }
                        row += '">'
                        if(eventName != '도움'){
                            keyEventHomeType.push(1);
                        }
                    } else {
                        row += '<li class="away K20 '
                        if(eventName == '득점'){
                            row += ' goal'
                        }
                        row += '">'
                        if(eventName != '도움'){
                            keyEventHomeType.push(2);
                        }
                    }
                    row += '<p style="font-size: 14px;">' + (parseInt(timeline[i].timeMin) > 45 ? ('45+'+(parseInt(timeline[i].timeMin)-45).toString()) : parseInt(timeline[i].timeMin)) + `'</p>`;
                    row += '<div>'
                    row += '    <p>'
                    if(eventName == '득점'){
                        row += ' <span>GOAL!</span>'
                    }
                    else{
                        row +=          eventNameLang[eventName]
                    }
                    row += '        <i class="'+ eventIconMap[eventName] +'"></i>'
                    row += '    </p>'

                    if (timeline[i].eventName == '교체') {
                        var timeMin = chkTimeMin(timeline[i].halfType, timeline[i].timeMin);
                        keyEventName.push(eventName);
                        keyEventTime.push(timeMin);
                        keyEventPlayer.push('In ' + timeline[i].playerName2 + ' ' + 'Out ' + timeline[i].playerName);

                        row += '    <span>'
                            + 'In ' + timeline[i].playerName2 + '/'
                            + 'Out ' + timeline[i].playerName
                        row += '    </span>'
                    }
                    else{
                        if(eventName != '도움'){ // 도움은 상단에 제외. 득점과 시간이 겹침
                            var timeMin = chkTimeMin(timeline[i].halfType, timeline[i].timeMin);
                            keyEventName.push(eventName);
                            keyEventTime.push(timeMin);
                            keyEventPlayer.push(timeline[i].playerName);
                        }
                        row += '    <span>'
                            + timeline[i].teamName + ' '
                            + timeline[i].backNo + ', '
                            + timeline[i].playerName
                        row += '    </span>'
                    }
                    row += '</div>'

                    $(tagId).append(row);
                    continue;
                }
                else {
                    var row = '';
                    if (isHome) {
                        row += '<li class="home K32">'

                    } else {
                        row += '<li class="away K20">'
                    }
                    row += '<p style="font-size: 14px;">' + (parseInt(timeline[i].timeMin) > 45 ? ('45+'+(parseInt(timeline[i].timeMin)-45).toString()) : parseInt(timeline[i].timeMin)) + `'</p>`;
                    row += '<div>'
                    row += '<p> ' + eventNameLang[eventName] + '</p>'
                    row += '    <span>'
                        + timeline[i].teamName + ' '
                        + timeline[i].backNo + ', '
                        + timeline[i].playerName
                    row += '    </span>'
                    row += '</div>'
                    row += '</ul>'

                    $(tagId).append(row);
                    continue;
                }
            }
        }

        $(".homeMainResult").empty()
        $(".awayMainResult").empty()
        var html = '';
        for (var i = 0; i < keyEventName.length; i++) {
            html = '<li><div>'
            if (keyEventName[i] == '교체') {
                html += `<i class="ic-change"></i>`
                keyEventPlayer[i] = keyEventPlayer[i].replace('In', '<i class="ic-in"></i>')
                keyEventPlayer[i] = keyEventPlayer[i].replace('Out', '<i class="ic-out"></i>')
            } else if (keyEventName[i] == '경고') {
                html += `<i class="ic-warn1"></i>`
            } else if (keyEventName[i] == '퇴장') {
                html += `<i class="ic-exit"></i>`
            } else if (keyEventName[i] == '경고누적') {
                html += `<i class="ic-warn2"></i>`
            } else if (keyEventName[i] == '득점') {
                html += `<i class="ic-ball"></i>`
            } else if (keyEventName[i] == '자책골') {
                html += `<i class="ic-ball2"></i>`
            } else {

            }
            html += '<p>' + keyEventTime[i] + ' \' ' + keyEventPlayer[i] + `</p></div></li>`

            if (keyEventHomeType[i] == 1) {
                $(".homeMainResult").append(html)

            } else {
                $(".awayMainResult").append(html)
            }
        }

        drawKeyEventTimeline(keyEventName, keyEventTime, keyEventHomeType)
    }

    function chkTimeMin(halfType, timeMin){
        if(halfType == 1){
            if(timeMin > 45){
                timeMin = '45+'+(timeMin-45)
            }
        }
        else if(halfType == 2){
            if(timeMin > 45){
                timeMin = '90+'+(timeMin-45)
            }
            else{
                timeMin += 45
            }
        }
        else if(halfType == 3){
            if(timeMin > 15){
                timeMin = '105+'+(timeMin-15)
            }
            else{
                timeMin += 90
            }
        }
        else if(halfType == 4){
            if(timeMin > 15){
                timeMin = '120+'+(timeMin-15)
            }
            else{
                timeMin += 90
            }
        }
        return timeMin;
    }

    function drawKeyEventTimeline(eventNames, eventTimes, homeTypes) {
        var times = eventTimes.map(time => {
            if (typeof time === 'string') {
                var parts = time.split('+');
                return parseInt(parts[0], 10) + (parseInt(parts[1], 10) || 0);
            } else {
                return time;
            }
        });

        var maxLeftTime = Math.max(...times.filter(time => time <= 45), 45); // Default to 45 if no values are <= 45
        var maxRightTime = Math.max(...times.filter(time => time > 45), 93); // Default to 93 if no values are > 45

        eventNames.forEach(function(eventName, index) {
            var eventTime = eventTimes[index];
            var homeType = homeTypes[index];
            if(homeType == 1){
                homeType = 'home'
            }
            else{
                homeType = 'away'
            }

            var time;
            if (typeof eventTime === 'string') {
                var parts = eventTime.split('+');
                time = parseInt(parts[0], 10) + (parseInt(parts[1], 10) || 0);
            } else {
                time = eventTime;
            }

            var positionPercentage;
            if (time <= 45) {
                positionPercentage = (time / maxLeftTime) * 50; // 0% to 50% for left side
            } else {
                positionPercentage = 50 + ((time - 46) / (maxRightTime - 46)) * 50; // 50% to 100% for right side
            }

            var positionStyle = 'left: ' + positionPercentage + '%;';

            var html = '';
            html += `<li style="`+ positionStyle + `">`
            html += `<p>`+time+`' </p>`
            if (eventName == '교체') {
                html += `<i class="ic-change `+ homeType +`"></i>`
            } else if (eventName == '경고') {
                html += `<i class="ic-warn1 `+ homeType +`"></i>`
            } else if (eventName == '퇴장') {
                html += `<i class="ic-exit `+ homeType +`"></i>`
            } else if (eventName == '경고누적') {
                html += `<i class="ic-warn2 `+ homeType +`"></i>`
            } else if (eventName == '득점') {
                html += `<i class="ic-ball `+ homeType +`"></i>`
            } else if (eventName == '자책골') {
                html += `<i class="ic-ball2 `+ homeType +`"></i>`
            } else {

            }
            html += `</li>`
            $(".record").append(html)
        });
    }

</script>


            
            



<script>
    function playerIco(homeAway, eventType, playerId, pos, gubunSubNm){

        
        if(playerId == '20180204'){
            $(".player__"+playerId).append('<span><i class="ic-lineup-mom"></i></span>&nbsp;&nbsp;')
            $(".player_"+playerId + " .score").append('<i class="ic-lineup-mom"></i>')
            $(".player_"+playerId + " .score").removeClass('green')
            $(".player_"+playerId + " .score").removeClass('orange')
            $(".player_"+playerId + " .score").removeClass('yellow')
            $(".player_"+playerId + " .score").addClass('blue')

        }
        

        if(eventType.indexOf('교체') > -1){
            if (pos == 'bc') {
                var changeCount = eventType.split('교체').length - 1;
                var timeMin1 = $(".changeM_" + playerId).text();
                var timeMin2 = $(".changeM2_" + playerId).text();
                let extraIcon = "";
                if (gubunSubNm === "뇌진탕") {
                    extraIcon = '<i class="ic-red-cross-circle"></i>';
                } else if (gubunSubNm === "추가교체") {
                    extraIcon = '<i class="ic-blue-cross-circle"></i>';
                }

                $(".player__" + playerId).append(
                    '<span style="font-size:8px;">' +
                    '<i class="ic-in"></i>' + extraIcon + ' (' + timeMin1 + '\'' + ')' +
                    '</span>&nbsp;&nbsp;'
                );

                $(".player_" + playerId + " .change").removeClass('off');
                $(".player_" + playerId + " .change").addClass('on');

                // 교체가 두 번인 경우 OUT 아이콘도 추가
                if(changeCount >= 2 && timeMin2){
                    $(".player__" + playerId).append(
                        '<span style="font-size:8px;"><i class="ic-out"></i> (' + timeMin2 + '\'' + ')</span>&nbsp;&nbsp;'
                    );
                }
            } else {
                let extraIcon = "";
                if (gubunSubNm === "뇌진탕") {
                    extraIcon = '<i class="ic-red-cross-circle"></i>';
                } else if (gubunSubNm === "추가교체") {
                    extraIcon = '<i class="ic-blue-cross-circle"></i>';
                }

                $(".player__" + playerId).append(
                    '<span style="font-size:8px;">' +
                    '<i class="ic-out"></i>' + extraIcon + ' (' + $(".changeM_" + playerId).text() + '\'' + ')' +
                    '</span>&nbsp;&nbsp;'
                );

                $(".player_" + playerId + " .change").removeClass('off');
                $(".player_" + playerId + " .change").addClass('on');

                var timeMin = $(".changeM_" + playerId).text() + '\'';

                $(".player_" + playerId + " .change p").text(timeMin);

                if (gubunSubNm === "뇌진탕") {
                    $(".player_" + playerId + " .change p").html(timeMin + '<i class="ic-red-cross-circle" style="margin-left: 6px"></i>');
                } else if (gubunSubNm === "추가교체") {
                    $(".player_" + playerId + " .change p").html(timeMin + '<i class="ic-blue-cross-circle" style="margin-left: 6px"></i>');
                }
            }
        }

        if(eventType.indexOf('득점') > -1){
            var count = eventType.split('득점').length - 1;
            $(".player__"+playerId).append('<span><i class="ic-ball"></i></span>&nbsp;&nbsp;')

            $(".player_"+playerId + " .ball01").removeClass('off')
            $(".player_"+playerId + " .ball01").addClass('on')
            if(count>1){
                $(".player_"+playerId + " .ball01").append('<p>'+count+'</p>')
            }
        }
        if(eventType.indexOf('도움') > -1){
            var count = eventType.split('도움').length - 1;
            $(".player__"+playerId).append('<span><i class="ic-lineup-assist"></i></span>&nbsp;&nbsp;')
            $(".player_"+playerId + " .assist").removeClass('off')
            $(".player_"+playerId + " .assist").addClass('on')
            if(count>1){
                $(".player_"+playerId + " .ball01").append('<p>'+count+'</p>')
            }
        }
        if(eventType.indexOf('자책골') > -1){
            var count = eventType.split('자책골').length - 1;
            $(".player__"+playerId).append('<span><i class="ic-ball2"></i></span>&nbsp;&nbsp;')
            $(".player_"+playerId + " .ball02").removeClass('off')
            $(".player_"+playerId + " .ball02").addClass('on')
            if(count>1){
                $(".player_"+playerId + " .ball02").append('<p>'+count+'</p>')
            }
        }
        if(eventType.indexOf('경고') > -1){
            $(".player_"+playerId + " .warn").removeClass('off')
            $(".player_"+playerId + " .warn").addClass('on')

            var firstIndex = eventType.indexOf('경고')
            var secondIndex = eventType.indexOf('경고', firstIndex+1);
            if(secondIndex > -1){ 
                $(".player__"+playerId).append('<span><i class="ic-warn2"></i></span>&nbsp;&nbsp;')
                $(".player_"+playerId + " .warn .icon").append('<i class="ic-warn2"></i>')
            }
            else{
                $(".player__"+playerId).append('<span><i class="ic-warn1"></i></span>&nbsp;&nbsp;')
                $(".player_"+playerId + " .warn .icon").append('<i class="ic-warn1"></i>')
            }
        }
        if(eventType.indexOf('퇴장') > -1){
            $(".player_"+playerId + " .warn").removeClass('off')
            $(".player_"+playerId + " .warn").addClass('on')
            $(".player__"+playerId).append('<span><i class="ic-exitexit02"></i></span>&nbsp;&nbsp;')
            $(".player_"+playerId + " .warn .icon").append('<i class="ic-exit"></i>')
        }
    }
</script>
<div id="tab02" class="match-tab-cont">
    
        
