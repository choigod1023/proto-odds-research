    <div id="sub-tab04" class="match-sub-tab-cont">
        <style>
            .color-dot {
                width: 20px;
                height: 20px;
                border-radius: 50%;
                display: inline-block;
                margin-right: 8px;
            }
            .blue { background-color: #4575b4; }   /* 0% (최소값) - 깊은 파란색 */
            .cyan { background-color: #91bfdb; }   /* 20% - 청록색 */
            .green { background-color: #313695; }  /* 40% - 깊은 녹색 */
            .yellow { background-color: #fbb03b; } /* 60% - 선명한 노란색 */
            .orange { background-color: #f6c73c; } /* 80% - 밝은 오렌지색 */
            .red { background-color: #d73027; }    /* 100% (최대값) - 선명한 빨간색 */
        </style>
        <div class="cont-box">
            <script src="https://d3js.org/d3.v7.min.js"></script>
            <script>
                $(function() {
                    let tab6_selectedTime = null;
                    let coordinates = [];

                    $(document).on('click', '.tab6_time li', function() {
                        $('.tab6_time li').removeClass('active');
                        $(this).addClass('active');
                        tab6_selectedTime = $(this).data('value');
                        if(tab6_selectedTime == 'A'){
                            tab6_selectedTime = null;
                        }
                        drawHeatmap();
                    });

                    $(".HeatmapSeq").off("click").on("click", function() {
                        if ($(this).prop('checked')) {
                            $(this).closest('li').addClass('active');
                        } else {
                            $(this).closest('li').removeClass('active');
                        }
                        drawHeatmap();
                    });

                    // 홈어웨이 전체
                    $("#checkHomePlayer").off("click").on("click", function() {
                        $('.heatmapChkboxH').prop('checked', this.checked);
                        drawHeatmap();
                    });
                    $("#checkAwayPlayer").off("click").on("click", function() {
                        $('.heatmapChkboxA').prop('checked', this.checked);
                        drawHeatmap();
                    });

                    // 체크박스 상태 활성화
                    $('.heatmapChkboxH').on('click', function() {
                        if ($('.heatmapChkboxH:checked').length === $('.heatmapChkboxH').length) {
                            $('#checkHomePlayer').prop('checked', true);
                        } else {
                            $('#checkHomePlayer').prop('checked', false);
                        }
                    });
                    $('.heatmapChkboxA').on('click', function() {
                        if ($('.heatmapChkboxA:checked').length === $('.heatmapChkboxA').length) {
                            $('#checkAwayPlayer').prop('checked', true);
                        } else {
                            $('#checkAwayPlayer').prop('checked', false);
                        }
                    });

                    function drawHeatmap() {
                        var playerList = [];
                        $(".HeatmapSeq:checked").each(function() {
                            var dataValue = $(this).val();
                            playerList.push(dataValue);
                        });

                        if(playerList.length > 0){
                            var formData = new FormData();
                            formData.append('MEET_YEAR', '2024')
                            formData.append('MEET_SEQ', '2')
                            formData.append('GAME_ID', '1')
                            formData.append('PLAYER_LIST', playerList)
                            if(tab6_selectedTime != null){
                                formData.append('PERIOD_ID', tab6_selectedTime)
                            }
                            formData.append('H_GK_PLAYER', '20150149')

                            $.ajax({
                                url: "/api/ddf/match/getHeatmapData.do",
                                type: "POST",
                                data: formData,
                                enctype: "multipart/form-data",
                                cache: false,
                                contentType: false,
                                processData: false,
                                success: function (res) {
                                    if (res.resultCode == "200") {
                                        var width = $("#heatmap").width();
                                        var height = $("#heatmap").height();

                                        if (attackDirection > 0){

                                            coordinates = res.data.coordinates.map(item => {
                                                if (item.PERIOD_ID === 1) {
                                                    return [
                                                        Math.round(item.START_POINT_X * width / 100),
                                                        Math.round(item.START_POINT_Y * height / 100)
                                                    ];
                                                } else if (item.PERIOD_ID === 2) {
                                                    return [
                                                        Math.round((100-item.START_POINT_X) * width / 100),
                                                        Math.round((100-item.START_POINT_Y) * height / 100)
                                                    ];
                                                }
                                                else{
                                                    return [0,0]
                                                }
                                            });
                                        }
                                        else{
                                            coordinates = res.data.coordinates.map(item => {
                                                if (item.PERIOD_ID === 2) {
                                                    return [
                                                        Math.round(item.START_POINT_X * width / 100),
                                                        Math.round(item.START_POINT_Y * height / 100)
                                                    ];
                                                } else if (item.PERIOD_ID === 1) {
                                                    return [
                                                        Math.round((100-item.START_POINT_X) * width / 100),
                                                        Math.round((100-item.START_POINT_Y) * height / 100)
                                                    ];
                                                }
                                                else{
                                                    return [0,0]
                                                }
                                            });
                                        }

                                        if(coordinates.length >0){
                                            updateHeatmap();
                                        }
                                        else{
                                            d3.select("#heatmap").select("svg").remove();
                                        }
                                    }
                                    else{
                                        alert("히트맵 데이터 로딩에 실패했습니다.")
                                    }
                                },
                                error: function (err) {
                                    console.log(err);
                                }
                            });
                        }
                        else{
                            d3.select("#heatmap").select("svg").remove();
                        }

                    }

                    function updateHeatmap() {
                        var width = $("#heatmap").width();
                        var height = $("#heatmap").height();

                        d3.select("#heatmap").select("svg").remove();
                        var svg = d3.select("#heatmap")
                            .append("svg")
                            .attr("width", width)
                            .attr("height", height);

                        var densityData = d3.contourDensity()
                            .x(d => d[0])
                            .y(d => d[1])
                            .size([width, height])
                            .bandwidth(10) // 부드러움 정도
                            .thresholds(20) // 등고선 레벨 수
                            (coordinates);

                        var color = d3.scaleSequential(d3.interpolateTurbo)
                            .domain([0, d3.max(densityData, d => d.value)]);

                        svg.selectAll("path")
                            .data(densityData)
                            .enter().append("path")
                            .attr("d", d3.geoPath())
                            .attr("fill", d => color(d.value))
                            .attr("stroke", "none") // 흰색 선 제거
                            .attr("opacity", 0.2); // 투명도 조절
                    }
                });
            </script>
            <div class="match-shooting-wrap">
                <div class="match-shooting" id="heatmap">
                    <i class="home ic-emblem K32"></i>
                    <i class="away ic-emblem K20"></i>
                </div>
                <div class="match-shooting-desc">
                    <ul>
                        <li><span class="color-dot blue"></span>0%~</li>
                        <li><span class="color-dot cyan"></span>20%</li>
                        <li><span class="color-dot green"></span>40%</li>
                        <li><span class="color-dot yellow"></span>60%</li>
                        <li><span class="color-dot orange"></span>80%</li>
                        <li><span class="color-dot red"></span>100%</li>
                    </ul>
                </div>
            </div>
        </div>

