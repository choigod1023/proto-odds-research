    <script>
        var chl_ast;  var ch_ast;  var chr_ast;  var cl_ast;  var cr_ast;  var hl_ast;  var hc_ast;  var hr_ast;  var ll_ast;  var lc_ast;  var lr_ast = 0;
        var chl_goal; var ch_goal; var chr_goal; var cl_goal; var cr_goal; var hl_goal; var hc_goal; var hr_goal; var ll_goal; var lc_goal; var lr_goal = 0;
        var reloadObj
        function draw(obj){
            reloadObj = obj;
            chl_ast=0;  ch_ast=0;  chr_ast=0;  cl_ast=0;  cr_ast=0;  hl_ast=0;  hc_ast=0;  hr_ast=0;  ll_ast=0;  lc_ast=0;  lr_ast=0;
            chl_goal=0;  ch_goal=0;  chr_goal=0;  cl_goal=0;  cr_goal=0;  hl_goal=0;  hc_goal=0;  hr_goal=0;  ll_goal=0;  lc_goal=0;  lr_goal=0;

            var canvas = document. getElementById ( "canvas" );
            canvas.width = canvas.width;

            var ctx = canvas. getContext ( "2d" );

            var image = new Image();
            image.src = "/assets/images/img-lineup-bg-2024_gray_turn.png";
            image.onload = function() {
                ctx.drawImage(image, 0, 0, canvas.width, canvas.height);

                var html = '';
                $(".score-desc").empty();
                html += `    <li><h4 class="gray">전체</h4><div></div><div><button onclick="drawAll();">보기</div></li>`

                // canvas 하단 상세 항목
                for(var i=0; i<obj.length; i++) {
                    var dto = obj[i];

                    html +=     `<li>`
                    html +=     `<div style="display: none;" id="obj_`+i+`">`
                    if(dto.expected_GOAL != null){
                        html +=     ' '+ dto.expected_GOAL
                    }
                    html +=     `</div>`

                    var gps = dto.shot_GOALPOST_SITE;
                    if (gps != null){
                        gps = '(' + gps + ')';
                        if(dto.type_DETAIL_CD == 'AST'){
                            switch(dto.shot_GOALPOST_SITE){
                                case 'CHL' : chl_ast++; break;
                                case 'CH'  : ch_ast++;  break;
                                case 'CHR' : chr_ast++; break;
                                case 'CL'  : cl_ast++;  break;
                                case 'CR'  : cr_ast++;  break;
                                case 'HL'  : hl_ast++;  break;
                                case 'HC'  : hc_ast++;  break;
                                case 'HR'  : hr_ast++;  break;
                                case 'LL'  : ll_ast++;  break;
                                case 'LC'  : lc_ast++;  break;
                                case 'LR'  : lr_ast++;  break;
                                default : break;
                            }
                        }
                        else if(dto.type_DETAIL_CD == 'GL'){
                            switch(dto.shot_GOALPOST_SITE){
                                case 'CHL' : chl_goal++; break;
                                case 'CH'  : ch_goal++;  break;
                                case 'CHR' : chr_goal++; break;
                                case 'CL'  : cl_goal++;  break;
                                case 'CR'  : cr_goal++;  break;
                                case 'HL'  : hl_goal++;  break;
                                case 'HC'  : hc_goal++;  break;
                                case 'HR'  : hr_goal++;  break;
                                case 'LL'  : ll_goal++;  break;
                                case 'LC'  : lc_goal++;  break;
                                case 'LR'  : lr_goal++;  break;
                                default : break;
                            }
                        }
                    }

                    if(dto.type_DETAIL_CD == 'GL'){
                        if(dto.own_GOAL_CODE == 'N'){
                            html +=         `<h4 style="color:red">득점<br>`
                                + gps
                                + `</h4>`
                            html +=         `<div><p>` + dto.min_TIME +  `분 ` + dto.sec_TIME + `초</p></div><div><button  onclick="drawNew('`+ dto.type_DETAIL_CD +`', '`+ dto.start_POINT_X +`', '`+ dto.start_POINT_Y +`', '`+ dto.end_POINT_X +`', '`+ dto.end_POINT_Y +`', '`+ i +`')">보기</button></div>`
                        }
                    }
                    else if(dto.type_DETAIL_CD == 'AST'){
                        html +=         `<h4 style="color:green">유효슈팅<br>` + gps + `</h4>`
                        html +=         `<div><p>` + dto.min_TIME +  `분 ` + dto.sec_TIME + `초</p></div><div><button  onclick="drawNew('`+ dto.type_DETAIL_CD +`', '`+ dto.start_POINT_X +`', '`+ dto.start_POINT_Y +`', '`+ dto.end_POINT_X +`', '`+ dto.end_POINT_Y +`', '`+ i +`')">보기</button></div>`
                    }
                    html +=     '</li>'
                }

                $(".score-desc").append(html);
                drawGoalPostSite();

                // draw canvas
                for(var i=0; i<obj.length; i++) {
                    var dto = obj[i];

                    if(dto.type_DETAIL_CD == 'GL'){
                        if(dto.own_GOAL_CODE == 'N'){
                            ctx.beginPath();
                            ctx.strokeStyle = 'red'
                            canvas_arrow(ctx, dto.start_POINT_X, dto.start_POINT_Y, dto.end_POINT_X, dto.end_POINT_Y, i);
                        }
                    }
                    else if(dto.type_DETAIL_CD == 'AST'){
                        ctx.beginPath();
                        ctx.strokeStyle = 'green'
                        canvas_arrow(ctx, dto.start_POINT_X, dto.start_POINT_Y, dto.end_POINT_X, dto.end_POINT_Y, i);
                    }
                }
            }
        }

        function drawGoalPostSite(){
            if( chl_goal != 0  ||  chl_ast != 0 ) {
                var tmpHtml = `<ul>`;
                if( chl_goal != 0 ) {
                    tmpHtml += `<li><i class="ico ico-goal"></i><p>`+ chl_goal  + `</p></li>`;
                }
                if( chl_ast != 0 ) {
                    tmpHtml += `<li><p>` + chl_ast  + `</p></li>`;
                }
                tmpHtml += `</ul>`;
                $(".popScoreArea .close-high-left").append(tmpHtml);
            }
            if( ch_goal  != 0  ||  ch_ast  != 0 ) {
                var tmpHtml = `<ul>`;
                if( ch_goal  != 0 ) {
                    tmpHtml += `<li><i class="ico ico-goal"></i><p>`+ ch_goal   + `</p></li>`;
                }
                if( ch_ast  != 0 ) {
                    tmpHtml += `<li><p>` + ch_ast   + `</p></li>`;
                }
                tmpHtml += `</ul>`;
                $(".popScoreArea .close-high").append(tmpHtml);
            }
            if( chr_goal != 0  ||  chr_ast != 0 ) {
                var tmpHtml = `<ul>`;
                if( chr_goal != 0 ) {
                    tmpHtml += `<li><i class="ico ico-goal"></i><p>`+ chr_goal  + `</p></li>`;
                }
                if( chr_ast != 0 ) {
                    tmpHtml += `<li><p>` + chr_ast  + `</p></li>`;
                }
                tmpHtml += `</ul>`;
                $(".popScoreArea .close-high-right").append(tmpHtml);
            }
            if( cl_goal  != 0  ||  cl_ast  != 0 ) {
                var tmpHtml = `<ul>`;
                if( cl_goal  != 0 ) {
                    tmpHtml += `<li><i class="ico ico-goal"></i><p>`+ cl_goal   + `</p></li>`;
                }
                if( cl_ast  != 0 ) {
                    tmpHtml += `<li><p>` + cl_ast   + `</p></li>`;
                }
                tmpHtml += `</ul>`;
                $(".popScoreArea .close-left").append(tmpHtml);
            }
            if( cr_goal  != 0  ||  cr_ast  != 0 ) {
                var tmpHtml = `<ul>`;
                if( cr_goal  != 0 ) {
                    tmpHtml += `<li><i class="ico ico-goal"></i><p>`+ cr_goal   + `</p></li>`;
                }
                if( cr_ast  != 0 ) {
                    tmpHtml += `<li><p>` + cr_ast   + `</p></li>`;
                }
                tmpHtml += `</ul>`;
                $(".popScoreArea .high-left").append(tmpHtml);
            }
            if( hl_goal  != 0  ||  hl_ast  != 0 ) {
                var tmpHtml = `<ul>`;
                if( hl_goal  != 0 ) {
                    tmpHtml += `<li><i class="ico ico-goal"></i><p>`+ hl_goal   + `</p></li>`;
                }
                if( hl_ast  != 0 ) {
                    tmpHtml += `<li><p>` + hl_ast   + `</p></li>`;
                }
                tmpHtml += `</ul>`;
                $(".popScoreArea .high-center").append(tmpHtml);
            }
            if( hc_goal  != 0  ||  hc_ast  != 0 ) {
                var tmpHtml = `<ul>`;
                if( hc_goal  != 0 ) {
                    tmpHtml += `<li><i class="ico ico-goal"></i><p>`+ hc_goal   + `</p></li>`;
                }
                if( hc_ast  != 0 ) {
                    tmpHtml += `<li><p>` + hc_ast   + `</p></li>`;
                }
                tmpHtml += `</ul>`;
                $(".popScoreArea .high-right").append(tmpHtml);
            }
            if( hr_goal  != 0  ||  hr_ast  != 0 ) {
                var tmpHtml = `<ul>`;
                if( hr_goal  != 0 ) {
                    tmpHtml += `<li><i class="ico ico-goal"></i><p>`+ hr_goal   + `</p></li>`;
                }
                if( hr_ast  != 0 ) {
                    tmpHtml += `<li><p>` + hr_ast   + `</p></li>`;
                }
                tmpHtml += `</ul>`;
                $(".popScoreArea .close-right").append(tmpHtml);
            }
            if( ll_goal  != 0  ||  ll_ast  != 0 ) {
                var tmpHtml = `<ul>`;
                if( ll_goal  != 0 ) {
                    tmpHtml += `<li><i class="ico ico-goal"></i><p>`+ ll_goal   + `</p></li>`;
                }
                if( ll_ast  != 0 ) {
                    tmpHtml += `<li><p>` + ll_ast   + `</p></li>`;
                }
                tmpHtml += `</ul>`;
                $(".popScoreArea .low-left").append(tmpHtml);
            }
            if( lc_goal  != 0  ||  lc_ast  != 0 ) {
                var tmpHtml = `<ul>`;
                if( lc_goal  != 0 ) {
                    tmpHtml += `<li><i class="ico ico-goal"></i><p>`+ lc_goal   + `</p></li>`;
                }
                if( lc_ast  != 0 ) {
                    tmpHtml += `<li><p>` + lc_ast   + `</p></li>`;
                }
                tmpHtml += `</ul>`;
                $(".popScoreArea .low-center").append(tmpHtml);
            }
            if( lr_goal  != 0  ||  lr_ast  != 0 ) {
                var tmpHtml = `<ul>`;
                if( lr_goal  != 0 ) {
                    tmpHtml += `<li><i class="ico ico-goal"></i><p>`+ lr_goal   + `</p></li>`;
                }
                if( lr_ast  != 0 ) {
                    tmpHtml += `<li><p>` + lr_ast   + `</p></li>`;
                }
                tmpHtml += `</ul>`;
                $(".popScoreArea .low-right").append(tmpHtml);
            }
        }

        function drawAll(){
            draw(reloadObj);
        }

        function drawNew(tdc, sx, sy, ex, ey, i){
            var canvas = document.getElementById('canvas')
            canvas.width = canvas.width; // 이미지 다 지우고나서,

            var ctx = canvas.getContext('2d')

            var image = new Image();
            image.src = "/assets/images/img-lineup-bg-2024_gray_turn.png";
            image.onload = function() {
                ctx.drawImage(image, 0, 0, canvas.width, canvas.height);
                // ctx.font='bold 13px Gulim';
                ctx.font='10px Gulim';

                ctx.beginPath();
                if(tdc == 'GL'){
                    ctx.strokeStyle = 'red'
                }
                else if(tdc == 'AST'){
                    ctx.strokeStyle = 'green'
                }
                canvas_arrow(ctx, sx, sy, ex, ey, i);
            }
        }

        function canvas_arrow(context, fromx, fromy, tox, toy, i) {
            var headlen = 8;
            var dx = tox - fromx;
            var dy = toy - fromy;
            var angle = Math.atan2(dy, dx);

            if(fromx > 50){
                context.textAlign = "end"
                if(fromx > 90){
                    fromx = Number(fromx) - 0.5
                    tox = Number(tox) - 0.5;
                }
            }
            else{
                context.textAlign = "start"
                if(fromx < 10){
                    fromx = Number(fromx) + 0.5
                    tox = Number(tox) + 0.5;
                }
            }

            fromx = fromx*3.8
            fromy = fromy*1.9
            tox = tox*3.8
            toy = toy*1.9

            context.moveTo(fromx, fromy);
            context.lineTo(tox, toy);

            // 끝 좌표 화살표
            context.lineTo(tox - headlen * Math.cos(angle - Math.PI / 6), toy - headlen * Math.sin(angle - Math.PI / 6));
            context.moveTo(tox, toy);
            context.lineTo(tox - headlen * Math.cos(angle + Math.PI / 6), toy - headlen * Math.sin(angle + Math.PI / 6));


            var txt = $("#obj_"+i).text(); txt += '  ';
            context.fillStyle = 'white';
            context.fillText(txt , fromx, fromy);
            context.stroke();


            // 시작 좌표 동그라미 생성
            // context.arc(fromx, fromy, 3, 0, Math.PI * 2, true)
            // context.stroke();

            // 시작 좌표 동그라미 배경 포함 생성  위에꺼 그리고 새로 그리는거
            context.beginPath();
            context.arc(fromx, fromy, 2, 0, Math.PI * 2);
            context.fillStyle = "midnightblue";
            context.fill();
            context.strokeStyle = "gray";
            context.stroke();

        }

        function pdfDownload(){
            window.open(
                "/match/pdfDownload.do?year=2024&meetSeq=2&gameId=1",
                "PrintReport",
                "width=800, height=800, toolbar=no, menubar=no, scrollbars=yes, resizable=no, location=no, directories=no, status=no"
            );
        }
    </script>
</div>

            
            




