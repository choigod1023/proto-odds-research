<html lang="ko">
<meta name="robots" content="noindex,nofollow">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="user-scalable=0, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, width=device-width"/>

    <title>K LEAGUE</title>
    <link rel="stylesheet" href="/assets/js/jquery-ui.min.css">
    <link rel="stylesheet" href="/assets/js/swiper5.3.8/swiper.min.css">
    <link rel="stylesheet" href="/assets/css/match.css?v=1.6">
    <script src="/assets/js/jquery.min.js"></script>
    <script src="/assets/js/jquery-ui.min.js"></script>
    <script src="/assets/js/swiper5.3.8/swiper.min.js"></script>
    <script src="/assets/js/script.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.0.0"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $("#themeBtn").css('display','none')

            // localStorage.setItem('color-theme', 'dark');

            // 경기 상단 기본 정보 로드, interval.  timeline 기반 연동 필요.
            updateMatchResult(2024, 2, 1);
            updateMatchBCInfo(2024, 2, 1);
            setInterval(function() {updateMatchResult(2024, 2, 1)}, 60 * 1000);

            $("#tab02").addClass('active')
            $(".tab2").addClass('active')
            loadData('2')

            // 페이지를 떠날 때 테마 초기화
            // $(window).on("beforeunload", function () {
            //     localStorage.setItem('color-theme', 'light'); // light 테마로 변경
            // });
        });

        window.addEventListener('load', function() {
            const savedTab = localStorage.getItem('startTabNum');
            if (savedTab) {
                loadData(savedTab); // 저장된 탭 렌더링
                document.querySelector('.match-tab01').value = savedTab;
            } else {
                loadData(3);
            }
        });
        function loadData(tabNo){
            localStorage.setItem('startTabNum', tabNo);
            if(tabNo == 1){

            }
            else if(tabNo == 2){

            }
            else if(tabNo == 3){

            }
            else if(tabNo == 4){

            }
            else if(tabNo == 5){
                getMatchRecordAllData()
            }
            else{

            }
        }

        function updateMatchResult(year, meetSeq, gameId) {
            updateMatchInfo(year, meetSeq, gameId);   // 득점, gameStatus
            updateMatchRecord();
        }
        function updateMatchBCInfo(year, meetSeq, gameId) {
            $.ajax({
                method: "POST",
                url: "/api/ddf/match/matchBCInfo.do",
                data: {
                    "year": year,
                    "meetSeq": meetSeq,
                    "gameId": gameId
                },
                success: function (res) {
                    if(res.data.bcInfo != null)
                        $(".sort-box").append('<li>'+res.data.bcInfo+'</li>');
                },
                error: function (err) {
                    console.log(err);
                }
            })
        }
        // gameStatus, timeline기반 득점, 타임라인상세
        function updateMatchInfo(year, meetSeq, gameId) {
            $.ajax({
                method: "POST",
                url: "/api/ddf/match/matchInfo.do",
                data: {
                    "year": year,
                    "meetSeq": meetSeq,
                    "gameId": gameId
                },
                success: function (res) {
                    var row = '<li>' + res.data.homeGoal + '</li>'
                        + "<li>-</li>"
                        + '<li>' + res.data.awayGoal + '</li>';
                    $(".matchInfoArea").html(row);

                    $("#matchInfoGameStatus").empty();
                    $("#matchInfoGameStatus").append(parseGameStatus(res.data.gameStatus));

                    updateScorer(res.data.homeScorer, res.data.awayScorer);
                    updateTimeline(res.data.firstHalf,res.data.secondHalf,res.data.EfirstHalf,res.data.EsecondHalf)
                },
                error: function (err) {
                    console.log(err);
                }
            })
        }


        function parseGameStatus(gameStatus) {
            var html = "";
            if (gameStatus == 'FE') {
                html += '<span class="label red">경기종료</span>';
            } else if (gameStatus.startsWith('1S')) {
                html += '<span class="label">전반'
                    + gameStatus.substring(2).trim()
                    + '분</span>';
            } else if (gameStatus.startsWith('2S')) {
                html += '<span class="label">후반'
                    + gameStatus.substring(2).trim()
                    + '분</span>';
            } else if (gameStatus.startsWith('3S')) {
                html += '<span class="label">연장전반'
                    + gameStatus.substring(2).trim()
                    + '분</span>';
            } else if (gameStatus.startsWith('4S')) {
                html += '<span class="label">연장후반'
                    + gameStatus.substring(2).trim()
                    + '분</span>';
            } else if (gameStatus.startsWith('1E')) {
                html += '<span class="label red">전반종료</span>';
            } else if (gameStatus.startsWith('2E')) {
                html += '<span class="label red">후반종료</span>';
            } else if (gameStatus.startsWith('3E')) {
                html += '<span class="label red">연장전반종료</span>';
            } else if (gameStatus.startsWith('4E')) {
                html += '<span class="label red">연장후반종료</span>';
            } else {
                html += '<span class="label blue">경기전</span>';
            }
            return html;
        }
        function updateScorer(homeScorer, awayScorer) {
            $('#scorerAreaHome').empty();
            $('#scorerAreaAway').empty();

            var scorerList = [[homeScorer, '#scorerAreaHome'], [awayScorer, '#scorerAreaAway']];
            for (let j = 0; j < scorerList.length; j++) {
                var tmpScorer = scorerList[j][0];
                for (let i = 0; i < tmpScorer.length; i++) {
                    var row = '';
                    var scorer = tmpScorer[i];
                    if (scorer.isOwnGoal) {
                        row += scorer.name + '(OG) ' + scorer.time + '\' ';
                    } else {
                        row += scorer.name + ' ' + scorer.time + '\' ';
                    }
                    $(scorerList[j][1]).append(row);
                }
            }
        }

        function getRoundList(year){
            if(year == '0'){
                year = $("#year").val()
            }

            var meetSeq = $("#meetSeq").val()
            $.ajax({
                type: "POST",
                url: "/api/ddf/match/getRoundList.do",
                data: {
                    "year": year,
                    "meetSeq": meetSeq
                },
                success: function (res) {
                    if (res.resultCode == 200) {
                        $("#roundId").empty();

                        var html = '';
                        html += '<option value="">선택</option>'
                        res.data.roundList.forEach(function (item) {
                            html += `<option value=`+item+`>R`+item+`</option>`
                        });

                        $("#roundId").append(html)
                        resetMatchList();
                    }
                },
                error: function (err) {
                    console.log("경기정보 업데이트 실패");
                    console.log(err);
                }
            });
        }
        function getRoundGameList(roundId){
            if(roundId != ''){
                var year = $("#year").val()
                var meetSeq = $("#meetSeq").val()

                $.ajax({
                    type: "POST",
                    url: "/api/ddf/match/getRoundGameList.do",
                    data: {
                        "year": year,
                        "meetSeq": meetSeq,
                        "roundId": roundId
                    },
                    success: function (res) {
                        if (res.resultCode == 200) {
                            $("#gameId").empty();
                            var html = '';
                            html += '<option value="">선택</option>'
                            res.data.roundGameList.forEach(function (item) {
                                html += `<option value="`+item.gameId+`">`+item.homeTeamName+'vs'+item.awayTeamName+ ' ('+item.gameDate+')</option>'

                            });

                            $("#gameId").append(html)
                        }
                    },
                    error: function (err) {
                        console.log("경기정보 업데이트 실패");
                        console.log(err);
                    }
                });
            }
        }

        function goToMatch(game) {
            const gameInfo = game.options[game.selectedIndex];
            const gameId = gameInfo.value;

            if(gameId != ''){
                const leagueId = gameInfo.className;
                var year = $("#year").val()
                var meetSeq = $("#meetSeq").val()
                location.href = '/match.do?year='+year+'&meetSeq='+meetSeq+'&gameId='+gameId+'&leagueId='+leagueId+'&startTabNum=1'
            }
        }
        function goToLastMatch(year, meetSeq, gameId) {
            var leagueId = meetSeq > 2 ? 1 : meetSeq;
            location.href = '/match.do?year='+year+'&meetSeq='+meetSeq+'&gameId='+gameId+'&leagueId='+leagueId+'&startTabNum=1'
        }


    </script>
</head>
