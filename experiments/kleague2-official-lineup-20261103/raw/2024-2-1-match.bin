<script>
    function showMatrix(homeFlag) {
        if (homeFlag == 1) {
            $(".awayMatrix").css('display','none')
            $(".homeMatrix").show()

            $(".passMatrixHome").addClass('active')
            $(".passMatrixAway").removeClass('active')
        }
        else{
            $(".homeMatrix").css('display','none')
            $(".awayMatrix").show()

            $(".passMatrixAway").addClass('active')
            $(".passMatrixHome").removeClass('active')
        }
    }


    function showMatrix(homeFlag) {
        if (homeFlag == 1) {
            $(".awayMatrix").css('display','none')
            $(".homeMatrix").show()

            $(".passMatrixHome").addClass('active')
            $(".passMatrixAway").removeClass('active')
        }
        else{
            $(".homeMatrix").css('display','none')
            $(".awayMatrix").show()

            $(".passMatrixAway").addClass('active')
            $(".passMatrixHome").removeClass('active')
        }
    }

    function getPassData(){
        var formData = new FormData();
        formData.append('year', '2024')
        formData.append('meetSeq', '2')
        formData.append('gameId', '1')
        formData.append('homeTeam', 'K32')
        formData.append('awayTeam', 'K20')

        $.ajax({
            url: "/api/ddf/match/getPassData.do",
            type: "POST",
            data: formData,
            enctype: "multipart/form-data",
            cache: false,
            contentType: false,
            processData: false,
            success: function (res) {
                // Home 팀 매트릭스 생성
                createMatrix(res.data.passHome, res.data.passCntMaxH, 'K32', '.homeMatrix');

                // Away 팀 매트릭스 생성
                createMatrix(res.data.passAway, res.data.passCntMaxA, 'K20', '.awayMatrix');
            },
            error: function (request, status, error) {
                alert("code:" + request.status + "\n" + "message:" + request.responseText + "\n" + "error:" + error);
            }
        });
    }

    // 매트릭스 생성 함수
    function createMatrix(passData, passCntMax, team, selector) {
        var html = '<table class="' + selector.substr(1) + '">';

        // colgroup 생성
        html += '<colgroup>';
        html += '<col style="width: 5%;">';
        html += '<col style="width: 7%;">';
        for (var i = 0; i < passData.playerNames.length; i++) {
            html += '<col style="width: ' + (88 / passData.playerNames.length) + '%;">';
        }
        html += '</colgroup>';

        // thead 생성
        html += '<thead>';
        html += '<tr>';
        html += '<th colspan="2" rowspan="2"><i class="ic-emblem ' + team + '"></i></th>';
        passData.playerIds.forEach(function(playerId) {
            html += '<th>' + (passData.positionMap[playerId] || '') + '</th>';
        });
        html += '</tr>';
        html += '<tr>';
        passData.playerNames.forEach(function(name) {
            html += '<th><p>' + name + '</p></th>';
        });
        html += '</tr>';
        html += '</thead>';

        // tbody 생성
        html += '<tbody>';
        passData.playerIds.forEach(function(playerId, rowIndex) {
            html += '<tr>';
            html += '<td>' + (passData.positionMap[playerId] || '') + '</td>';
            html += '<td>' + passData.playerNames[rowIndex] + '</td>';
            passData.playerIds.forEach(function(targetId) {
                var passCount = passData.passMatrix[playerId] && passData.passMatrix[playerId][targetId] != null
                    ? passData.passMatrix[playerId][targetId]
                    : 0;
                var level = passCount !== 0 ? Math.floor(passCount / passCntMax * 16) : 0;
                html += '<td class="level' + level + '">' + passCount + '</td>';
            });
            html += '</tr>';
        });
        html += '</tbody>';

        html += '</table>';

        $(selector).html(html);
    }
</script>



            
        </div>

    </div>
</div>


  	




