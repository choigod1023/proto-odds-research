<script>
/*
 * 261008 Google Charts loader.js 를 async 로 로드 (동기 로드 시 응답이 올 때까지 본문 파싱이 멈춤)
 *        loader.js 도착 전의 google.charts.load / setOnLoadCallback 호출은 쌓아 두었다가 onload 에서 실제 함수로 다시 실행한다.
 *        loader.js 는 기존 google.charts 객체를 유지한 채 load / setOnLoadCallback 만 덮어쓴다.
 */
var _gchartsQueue = [];
window.google = window.google || {};
google.charts = google.charts || {};
google.charts.load = function () { return _gchartsDefer('load', arguments); };
google.charts.setOnLoadCallback = function () { return _gchartsDefer('setOnLoadCallback', arguments); };
function _gchartsDefer(fn, args) {
	return new Promise(function (resolve, reject) {
		_gchartsQueue.push({fn: fn, args: args, resolve: resolve, reject: reject});
	});
}
function _gchartsReady() {
	/*
	 * 같은 loader 에서 load 를 두 번 부르면 버전 43 이 두 번째 호출에 돌려주는 Promise 가 패키지 로드 전에 끝나
	 * load('current', ...).then() 안에서 google.visualization.DataTable 이 아직 없다.
	 * 이미 받은 패키지만 요청하는 두 번째 이후 호출은 실제 load 를 다시 부르지 않고 첫 load 의 완료 Promise 를 돌려준다.
	 */
	var realLoad = google.charts.load;
	var loadedPackages = null;
	google.charts.load = function () {
		var opt = {};
		for (var i = 0; i < arguments.length; i++) {
			if (arguments[i] && typeof arguments[i] === 'object') opt = arguments[i];
		}
		var packages = [].concat(opt.packages || ['corechart']).map(function (p) { return String(p).toLowerCase(); });

		if (loadedPackages === null) {
			loadedPackages = packages;
			return realLoad.apply(google.charts, arguments);
		}

		var missing = packages.filter(function (p) { return loadedPackages.indexOf(p) < 0; });
		if (missing.length) {
			loadedPackages = loadedPackages.concat(missing);
			return realLoad.apply(google.charts, arguments);
		}

		if (typeof opt.callback === 'function') google.charts.setOnLoadCallback(opt.callback);
		return google.charts.setOnLoadCallback();
	};

	var queue = _gchartsQueue;
	_gchartsQueue = [];
	for (var i = 0; i < queue.length; i++) {
		try {
			Promise.resolve(google.charts[queue[i].fn].apply(google.charts, queue[i].args)).then(queue[i].resolve, queue[i].reject);
		} catch (e) {
			queue[i].reject(e);
		}
	}
}
</script>
<script async src="https://www.gstatic.com/charts/loader.js" onload="_gchartsReady();"></script>
