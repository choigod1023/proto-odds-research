<!--W 채널 라이브 카운트다운 -->
<script type="text/javascript">
function getTime() {

	now1 = new Date();
	later1 = new Date("".replace(/-/g, "/")); //완료시간 지정 - 월 일 년 시 분 초

	days1 = (later1 - now1) / 1000 / 60 / 60 / 24;
	daysRound1 = Math.floor(days1);
	hours1 = (later1 - now1) / 1000 / 60 / 60 - (24 * daysRound1);
	hoursRound1 = Math.floor(hours1);
	minutes1 = (later1 - now1) / 1000 /60 - (24 * 60 * daysRound1) - (60 * hoursRound1);
	minutesRound1 = Math.floor(minutes1);
	seconds1 = (later1 - now1) / 1000 - (24 * 60 * 60 * daysRound1) - (60 * 60 * hoursRound1) - (60 * minutesRound1);
	secondsRound1 = Math.round(seconds1);

	if (now1 <= later1) {

		if (secondsRound1 <= 9) {

			document.getElementById('Time_s1').innerHTML = '0';
			document.getElementById('Time_s2').innerHTML = secondsRound1;
		} else {

			document.getElementById('Time_s1').innerHTML = Math.floor(secondsRound1 / 10);
			document.getElementById('Time_s2').innerHTML = secondsRound1 % 10;
		}

		if (minutesRound1 <= 9) {

			document.getElementById('Time_m1').innerHTML = '0';
			document.getElementById('Time_m2').innerHTML = minutesRound1;
		} else {

			document.getElementById('Time_m1').innerHTML = Math.floor(minutesRound1 / 10);
			document.getElementById('Time_m2').innerHTML = minutesRound1 % 10;
		}

		if (hoursRound1 <= 9) {

			document.getElementById('Time_h1').innerHTML = '0';
			document.getElementById('Time_h2').innerHTML = hoursRound1;
		} else {

			document.getElementById('Time_h1').innerHTML = Math.floor(hoursRound1 / 10);
			document.getElementById('Time_h2').innerHTML = hoursRound1 % 10;
		}

		if (daysRound1 <= 9) {

			document.getElementById('Time_d1').innerHTML = '0';
			document.getElementById('Time_d2').innerHTML = '';

			if (daysRound1 == 0) {

				document.getElementById('Time_d3').innerHTML = '0';
			} else {

				document.getElementById('Time_d3').innerHTML = daysRound1;
			}
		} else {

			document.getElementById('Time_d1').innerHTML = '';
			document.getElementById('Time_d2').innerHTML = Math.floor(daysRound1 / 10);
			document.getElementById('Time_d3').innerHTML = daysRound1 % 10;
		}

		newtime = window.setTimeout('getTime();', 1000);
	}
}
getTime();
</script>
<!--W 채널 라이브 카운트다운 -->


<!--영상센터 라이브 카운트다운 -->
<script type="text/javascript">
function getTime_v() {

	now1 = new Date();
	later1 = new Date("2020-07-23 16:00:00".replace(/-/g, "/")); //완료시간 지정 - 월 일 년 시 분 초

	days1 = (later1 - now1) / 1000 / 60 / 60 / 24;
	daysRound1 = Math.floor(days1);
	hours1 = (later1 - now1) / 1000 / 60 / 60 - (24 * daysRound1);
	hoursRound1 = Math.floor(hours1);
	minutes1 = (later1 - now1) / 1000 /60 - (24 * 60 * daysRound1) - (60 * hoursRound1);
	minutesRound1 = Math.floor(minutes1);
	seconds1 = (later1 - now1) / 1000 - (24 * 60 * 60 * daysRound1) - (60 * 60 * hoursRound1) - (60 * minutesRound1);
	secondsRound1 = Math.round(seconds1);

	if (now1 <= later1) {

		if (secondsRound1 <= 9) {

			document.getElementById('Time_s1_v').innerHTML = '0';
			document.getElementById('Time_s2_v').innerHTML = secondsRound1;
		} else {

			document.getElementById('Time_s1_v').innerHTML = Math.floor(secondsRound1 / 10);
			document.getElementById('Time_s2_v').innerHTML = secondsRound1 % 10;
		}

		if (minutesRound1 <= 9) {

			document.getElementById('Time_m1_v').innerHTML = '0';
			document.getElementById('Time_m2_v').innerHTML = minutesRound1;
		} else {

			document.getElementById('Time_m1_v').innerHTML = Math.floor(minutesRound1 / 10);
			document.getElementById('Time_m2_v').innerHTML = minutesRound1 % 10;
		}

		if (hoursRound1 <= 9) {

			document.getElementById('Time_h1_v').innerHTML = '0';
			document.getElementById('Time_h2_v').innerHTML = hoursRound1;
		} else {

			document.getElementById('Time_h1_v').innerHTML = Math.floor(hoursRound1 / 10);
			document.getElementById('Time_h2_v').innerHTML = hoursRound1 % 10;
		}

		if (daysRound1 <= 9) {

			document.getElementById('Time_d1_v').innerHTML = '0';
			document.getElementById('Time_d2_v').innerHTML = '';

			if (daysRound1 == 0) {

				document.getElementById('Time_d3_v').innerHTML = '0';
			} else {

				document.getElementById('Time_d3_v').innerHTML = daysRound1;
			}
		} else {

			document.getElementById('Time_d1_v').innerHTML = '';
			document.getElementById('Time_d2_v').innerHTML = Math.floor(daysRound1 / 10);
			document.getElementById('Time_d3_v').innerHTML = daysRound1 % 10;
		}

		newtime = window.setTimeout('getTime_v();', 1000);
	}
}

getTime_v();
</script>
<!--영상센터 라이브 카운트다운 --><script type="text/javascript">
function msgposit_list(evt2) {

	cw = document.body.clientWidth / 2;

	if (navigator.appName == "Netscape") {

		if (navigator.appVersion.indexOf('Chrome') > 0) {

			document.getElementById('infobox').style.left = (event.pageX - cw + 190) + 'px';
			document.getElementById('infobox').style.top = event.pageY - 415 + 'px';
		} else {

			document.getElementById('infobox').style.left = (evt2.pageX - cw + 190) + 'px';
			document.getElementById('infobox').style.top = evt2.pageY - 415 + 'px';
		}
	} else {

		document.getElementById('infobox').style.posLeft = (event.clientX - cw + 190) + document.documentElement.scrollLeft;
		document.getElementById('infobox').style.posTop = event.clientY - 415 + document.documentElement.scrollTop;
	}
}

function msgset_list(str) {

	var text;
	text = '<table width="286" cellpadding="0" cellspacing="0" border="0"><tr><td colspan="3" style="line-height:0"><img src="https://storage.wisetoto.com/images/common/bg/layer_box_t.gif" width="286" height="7" border="0" align="absmiddle" alt="" /></td></tr><tr><td width="7" background="https://storage.wisetoto.com/images/common/bg/layer_box_l.gif"></td>';
	text += '<td bgcolor="#ffffff" width="256" align="left" style="padding-left:10px;word-break: break-all">'+str+'</td><td width="23" background="https://storage.wisetoto.com/images/common/bg/layer_box_r_bg.gif" valign="bottom"><img src="https://storage.wisetoto.com/images/common/bg/layer_box_r.gif" width="23" height="71" border="0" align="absmiddle" alt="" /></td></tr><tr><td colspan="3"><img src="https://storage.wisetoto.com/images/common/bg/layer_box_b.gif" width="286" height="9" border="0" align="absmiddle" alt="" /></td></tr></table>';
	document.getElementById('infobox').innerHTML = text;
}

function msghide_list() {

	document.getElementById('infobox').innerHTML = '';
}

if (navigator.appName == "Netscape") {

	document.captureEvents(Event.MOUSEDOWN | Event.MOUSEMOVE | Event.MOUSEUP);
	document.onmousemove = msgposit_list;
}

var before_game_no = '';
var before_div_id = '';
var before_detail_tab = '';

var now_sports = '';
var now_sort = '';

var intervalHandle;
var nowParams = getUrlParams();
var focusMove = true;

var page_type = "";

if (typeof(nowParams['game_type']) !== 'undefined' && typeof(nowParams['game_year']) !== 'undefined') {

	document.title = '프로토 승부식 2026년도 104회차 :: 와이즈토토';
	$('#description').attr('content', '프로토 승부식 2026년도 104회차 분석글,라이브스코어,국내/해외 배당률,부상자명단,선발/정지명단,해외배당률,결과');
}

function getUrlParams() {
	var params = {};
	window.location.search.replace(/[?&]+([^=&]+)=([^&]*)/gi, function(str, key, value) { params[key] = value; });
	return params;
}

function ChangeUrl(page, url) {
	if (typeof (history.pushState) != "undefined") {
		var obj = {Page: page, Url: url};
		history.pushState(obj, obj.Page, obj.Url);
	} else {
		window.location.href = url;
	}
}

function getParamChangeUrl(paramName, paramValue) {

	var url = '';	// 변경할 URL
	var params = [];	// 전체 파라미터
	var size = 0;	// 파라미터 갯수 담을 변수
	var href = window.location.href.split('#');	// 현재 URL
	var queryString = href[0].split('?');	// 쿼리스트링 분리

	if (queryString.length > 1)	 {
	// 1-1 파라미터 존재할 경우

		url = queryString[0];	// 현재 도메인
		params = queryString[1].split('&');	// 파라미터 분리
		size = params.length;	// 파라미터 갯수

		var temp = [];	// 파라미터 변수와 값 분리
		var isFocus = false;	// 원하는 파라미터 존재여부

		for (i = 0; i < size; i++) {

			if (i==0) url += '?';	// 쿼리스트링 시작

			temp = params[i].split('=');	// 파라미터 필드와 값 분리
			if (temp[0] == paramName) {
			// 2-1 원하는 파라미터가 있을 경우

				isFocus = true;

				if (temp[1] != paramValue) {
				// 기존 값과 다를 경우

					if (i!=0) url += '&';
					url = url + paramName + '=' + paramValue;
				}

			} else {
			// 2-2 focus 가 없을 경우

				if (i!=0) url += '&';
				url += params[i];
			}
		}

		if (!isFocus) {

			if (size>0) url += '&';
			url = url + paramName + '=' + paramValue;
		}
	} else {
	// 1-2 파라미터 존재하지 않을 경우

		url = href[0] + '?' + paramName + '=' + paramValue;
	}

	return url;
}

function change_formation(schedule_info_seq, team_info_seq, seq_sort, home_away) {

	$.ajax({
		url:'/util/gameinfo/get_detail_lineup_draw_'+home_away+'.htm?schedule_info_seq='+schedule_info_seq+'&team_info_seq='+team_info_seq+'&nowchk=n',
		type: 'GET',
		dataType: 'html',
		timeout: 10000, //10초이상 응답 없을 경우 에러 처리
		error: function(){
		},
		success: function(html) {

			for (var i=0; i<5; i++) {
				if (i == seq_sort) {
					$('#'+home_away+'_seq_'+i).addClass('active');
				} else {
					$('#'+home_away+'_seq_'+i).removeClass('active');
				}
			}

			$('#formation_'+home_away+'_warp_inner').remove();
			document.getElementById('formation_'+home_away+'_warp').innerHTML = html;
		}
	});
}

// 라인업 일정 클릭시
function change_record(schedule_info_seq, team_info_seq, seq_sort, home_away, sports, record_page_value, state) {
	$.ajax({
		url:'/util/gameinfo/get_detail_lineup_'+sports+'.htm?schedule_info_seq='+schedule_info_seq+'&team_info_seq='+team_info_seq+'&record_page_value='+record_page_value+'&home_away='+home_away+'&state='+state,
		type: 'GET',
		dataType: 'html',
		timeout: 10000, //10초이상 응답 없을 경우 에러 처리
		error: function(){
		},
		success: function(html) {
			if (seq_sort != null) {
				for (var i=0; i<5; i++) {
					if (i == seq_sort) {
						$('#'+home_away+'_seq_'+i).addClass('active');
					} else {
						$('#'+home_away+'_seq_'+i).removeClass('active');
					}
				}
			}
				$('#record_warp_inner_'+home_away+state).remove();
				document.getElementById('record_warp_'+home_away+state).innerHTML = html;
		}
	});
}

