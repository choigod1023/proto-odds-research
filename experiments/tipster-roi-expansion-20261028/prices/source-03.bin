		success: function(html) {
			if (seq_sort != null) {
				for (var i=0; i<5; i++) {
					if (i == seq_sort) {
						$('#'+home_away+'_seq_'+i).addClass('active');
					} else {
						$('#'+home_away+'_seq_'+i).removeClass('active');
					}
				}
			}
				$('#record_warp_inner_b_'+home_away+state).remove();
				//$('#record_warp_bs_b_record'+home_away+state).append(html);
				document.getElementById('record_warp_bs_b_record'+home_away+state).innerHTML = html;
		}
	});
}

function change_detail_tab(detail_tab, schedule_info_seq, tab_type, game_no, game_year, game_round, league_info_seq, limit, same_home_away, sports) {

	schedule_info_seq = typeof schedule_info_seq !== 'undefined' ? schedule_info_seq : null;

	$.ajax({
		url:'/util/gameinfo/get_detail_' + detail_tab + '.htm?schedule_info_seq=' + schedule_info_seq + '&tab_type=' + tab_type + '&game_year=' + game_year + '&game_round=' + game_round + '&game_no=' + game_no + '&league_info_seq=' + league_info_seq + '&limit=' + limit + '&same_home_away=' + same_home_away,
		type: 'GET',
		dataType: 'html',
		timeout: 10000, //10초이상 응답 없을 경우 에러 처리
		error: function(){
		},
		success: function(html) {

			if (detail_tab == 'statistics' || detail_tab == 'match_record' || detail_tab == 'latest_record') {

				var return_temp = html;
				var gameinfo_body_temp_arr = return_temp.split('|!|');

				document.getElementById('dit_content').innerHTML = gameinfo_body_temp_arr[0];

				return_temp_script = gameinfo_body_temp_arr[1];
				eval(return_temp_script);

				return_temp = null;
				gameinfo_body_temp_arr = null;
				return_temp_script = null;
			} else {

				document.getElementById('dit_content').innerHTML = html;
			}

			if (detail_tab == 'rate_info') {

				var schedule_data = html.split('<div style="display:none;">');

				var gameinfo_state = schedule_data[1].split('|!|');
				var schedule_data_arr = gameinfo_state[0].split('||');

				// 일반, 핸디 언오버 갯수 분기
				if (schedule_data_arr.length >= 1 && (tab_type == 'proto' || tab_type == 'toto')) {

					var rate_chk = new Array();

					jQuery.each(schedule_data_arr, function(index, element) {

						var element_arr = element.split('|');

						drawWinChart(game_year, gameinfo_state[2], element_arr[0], element_arr[1], sports, gameinfo_state[1]);

						rate_chk.push(element_arr[1]);
					});

					if (jQuery.inArray('n', rate_chk) < 0) {
						drawWinChart_n(game_year,game_round,game_no, 'n');
					}

					if (jQuery.inArray('y', rate_chk) < 0) {
						drawWinChart_n(game_year,game_round,game_no, 'y');
					}

					if (jQuery.inArray('y2', rate_chk) < 0) {
						drawWinChart_n(game_year,game_round,game_no, 'y2');
					}

					if (jQuery.inArray('u', rate_chk) < 0) {
						drawWinChart_n(game_year,game_round,game_no, 'u');
					}

					if (jQuery.inArray('1', rate_chk) < 0) {
						drawWinChart_n(game_year,game_round,game_no, '1');
					}

					if (jQuery.inArray('5', rate_chk) < 0) {
						drawWinChart_n(game_year,game_round,game_no, '5');
					}

					if (jQuery.inArray('e', rate_chk) < 0) {
						drawWinChart_n(game_year,game_round,game_no, 'e');
					}

					if (jQuery.inArray('d', rate_chk) < 0) {
						drawWinChart_n(game_year,game_round,game_no, 'd');
					}

					if (jQuery.inArray('f', rate_chk) < 0) {
						drawWinChart_n(game_year,game_round,game_no, 'f');
					}

					if (jQuery.inArray('x', rate_chk) < 0) {
						drawWinChart_n(game_year,game_round,game_no, 'x');
					}
				}
			}

			if (before_detail_tab != '') {

				$('#dit_' + before_detail_tab).removeClass('active');
			}

			$('#dit_' + detail_tab).addClass('active');

			before_detail_tab = detail_tab;
		}
	});
}


function drawWinChart(game_year, game_round, game_no, rate_kind, sports, state) {

	$.ajax({
		url:'/util/gameinfo/get_same_rate_info.htm?game_year=' + game_year + '&game_round=' + game_round + '&game_no=' + game_no + '&rate_kind=' + rate_kind,
		type: 'GET',
		dataType: 'json',
		async: true,
		timeout: 10000, //10초이상 응답 없을 경우 에러 처리
		error: function(){
		},
		success: function(json) {

			google.charts.setOnLoadCallback(function(){

				var w_m_per = 0;
				var w_cnt	= 0;
				var all_cnt = 0;
				var w_n_per = 0;

				var d_m_per = 0;
				var d_cnt	= 0;
				var d_n_per = 0;

				var l_m_per = 0;
				var l_cnt	= 0;
				var l_n_per = 0;

				const pt1_half_game = json['rate']['pt1_half_game'];

				if (json['all_cnt'] != 0) {

					w_m_per = json['w_m_per'];
					w_cnt	= json['w_cnt'] ? json['w_cnt'] : 0;
					all_cnt = json['all_cnt'];
					w_n_per = parseInt(json['w_m_per']);

					d_m_per = json['d_m_per'];
					d_cnt	= json['d_cnt'] ? json['d_cnt'] : 0;
					all_cnt = json['all_cnt'];
					d_n_per = parseInt(json['d_m_per']);

					l_m_per = json['l_m_per'];
					l_cnt	= json['l_cnt'] ? json['l_cnt'] : 0;
					all_cnt = json['all_cnt'];
					l_n_per = parseInt(json['l_m_per']);
				}


				if (all_cnt != null && json['rate']['home_w_rate'] != '1.00' && json['rate']['home_w_rate'] != null) {

					var w_text = '<strong>'+w_m_per+'%</strong><span>'+w_cnt+' / '+all_cnt+'</span>';
				} else {

					var w_text = '<strong>-%</strong><span>-</span>';
					w_m_per = 0;
				}

				if (all_cnt != null && json['rate']['home_d_rate'] != '1.00' && json['rate']['home_d_rate'] != null) {

					var d_text = '<strong>'+d_m_per+'%</strong><span>'+d_cnt+' / '+all_cnt+'</span>';
				} else {

					var d_text = '<strong>-%</strong><span>-</span>';
					d_m_per = 0;
				}

				if (all_cnt != null && json['rate']['home_l_rate'] != '1.00' && json['rate']['home_l_rate'] != null) {

					var l_text = '<strong>'+l_m_per+'%</strong><span>'+l_cnt+' / '+all_cnt+'</span>';
				} else {

					var l_text = '<strong>-%</strong><span>-</span>';
					l_m_per = 0;
				}

				drawCircleChart('circle_chart_'+rate_kind+'_1', {
					value_color : 'darkgray', // 값유지
					msg : w_text, // 가운데 택스트
					msg_style : null, // 널유지
					rowval :{
						'0' : {value : parseInt(w_m_per), color : '#0060a3'},
						'1' : {value : 100-w_n_per, color : '#d9d9d9'},
					},
					pieHole : 0.7 // 굵기
				});

				if (
					rate_kind != 'u'
					&& rate_kind != 'e'
					&& rate_kind != 'x'
				) {
					drawCircleChart('circle_chart_'+rate_kind+'_2', {
						value_color : 'darkgray', // 값유지
						msg : d_text, // 가운데 택스트
						msg_style : null, // 널유지
						rowval :{
							'0' : {value : parseInt(d_m_per), color : '#606060'},
							'1' : {value : 100-d_n_per, color : '#d9d9d9'},
						},
						pieHole : 0.7 // 굵기
					});
				}

				drawCircleChart('circle_chart_'+rate_kind+'_3', {
					value_color : 'darkgray', // 값유지
					msg : l_text, // 가운데 택스트
					msg_style : null, // 널유지
					rowval :{
						'0' : {value : parseInt(l_m_per), color : '#d20000'},
						'1' : {value : 100-l_n_per, color : '#d9d9d9'},
					},
					pieHole : 0.7 // 굵기
				});

				if (
					rate_kind != 'u'
					&& rate_kind != 'e'
					&& rate_kind != 'x'
				) {

					if (json['rate']['home_w_rate'] == null) {
						var home_w_rate = "<li><span>-</span></li>";
					} else {
						if (json['rate']['home_w_rate'] == '1.00') {
							var home_w_rate = "<li><strike style='line-height:30px;'>"+json['rate']['home_w_rate']+"</strike></li>";
						} else {
							var home_w_rate = "<li><span onclick=rs('"+game_year+"','"+game_round+"','"+game_no+"','"+sports+"','w','"+state+"','"+rate_kind+"','"+pt1_half_game+"')"+" class='pt'>"+json['rate']['home_w_rate']+"</span></li>";
						}
					}

					if (json['rate']['home_d_rate'] == null) {
						var home_d_rate = "<li><span>-</span></li>";
					} else {
						if (json['rate']['home_d_rate'] == '1.00') {
							var home_d_rate = "<li><strike style='line-height:30px;'>"+json['rate']['home_d_rate']+"</strike></li>";
						} else {
							var home_d_rate = "<li><span onclick=rs('"+game_year+"','"+game_round+"','"+game_no+"','"+sports+"','d','"+state+"','"+rate_kind+"','"+pt1_half_game+"')"+" class='pt'>"+json['rate']['home_d_rate']+"</span></li>";
						}
					}

					if (json['rate']['home_l_rate'] == null) {
						var home_l_rate = "<li><span>-</span></li>";
					} else {
						if (json['rate']['home_l_rate'] == '1.00') {
							var home_l_rate = "<li><strike style='line-height:30px;'>"+json['rate']['home_l_rate']+"</strike></li>";
						} else {
							var home_l_rate = "<li><span onclick=rs('"+game_year+"','"+game_round+"','"+game_no+"','"+sports+"','l','"+state+"','"+rate_kind+"','"+pt1_half_game+"')"+" class='pt'>"+json['rate']['home_l_rate']+"</span></li>";
						}
					}

				} else {

					if (json['rate']['home_w_rate'] == null) {
						var home_w_rate = "<li><span>-</span></li>";
					} else {
						if (json['rate']['home_w_rate'] == '1.00') {
							var home_w_rate = "<li><strike style='line-height:30px;'>"+json['rate']['home_w_rate']+"</strike></li>";
						} else {
							var home_w_rate = "<li><span onclick=rs('"+game_year+"','"+game_round+"','"+game_no+"','"+sports+"','w','"+state+"','"+rate_kind+"','"+pt1_half_game+"')"+" class='pt'>"+json['rate']['home_w_rate']+"</span></li>";
						}
					}

					if (json['rate']['home_l_rate'] == null) {
						var home_l_rate = "<li><span>-</span></li>";
					} else {
						if (json['rate']['home_l_rate'] == '1.00') {
							var home_l_rate = "<li><strike style='line-height:30px;'>"+json['rate']['home_l_rate']+"</strike></li>";
						} else {
							var home_l_rate = "<li><span onclick=rs('"+game_year+"','"+game_round+"','"+game_no+"','"+sports+"','l','"+state+"','"+rate_kind+"','"+pt1_half_game+"')"+" class='pt'>"+json['rate']['home_l_rate']+"</span></li>";
						}
					}
				}
				$('#chart_wrap_'+rate_kind).append("<ul class='score_list'>"+home_w_rate+home_d_rate+home_l_rate+"</ul>");
			});
		}
	});
}

function drawWinChart_n(game_year, game_round, game_no, rate_kind) {

	google.charts.setOnLoadCallback(function(){

		var all_cnt = 0;

		var w_m_per = 0;
		var w_cnt	= 0;
		var w_n_per = 0;

		var d_m_per = 0;
		var d_cnt	= 0;
		var d_n_per = 0;

		var l_m_per = 0;
		var l_cnt	= 0;
		var l_n_per = 0;


		drawCircleChart('circle_chart_'+rate_kind+'_1', {
			value_color : 'darkgray', // 값유지
			msg : '<strong>-%</strong><span>-</span>', // 가운데 택스트
			msg_style : null, // 널유지
			rowval :{
				'0' : {value : parseInt(w_m_per), color : '#0060a3'},
				'1' : {value : 100-w_n_per, color : '#d9d9d9'},
			},
			pieHole : 0.7 // 굵기
		});

		if (
			rate_kind != 'u'
			&& rate_kind != 'e'
			&& rate_kind != 'x'
		) {

			drawCircleChart('circle_chart_'+rate_kind+'_2', {
				value_color : 'darkgray', // 값유지
				msg : '<strong>-%</strong><span>-</span>', // 가운데 택스트
				msg_style : null, // 널유지
				rowval :{
					'0' : {value : parseInt(d_m_per), color : '#606060'},
					'1' : {value : 100-d_n_per, color : '#d9d9d9'},
				},
				pieHole : 0.7 // 굵기
			});
		}

		drawCircleChart('circle_chart_'+rate_kind+'_3', {
			value_color : 'darkgray', // 값유지
			msg : '<strong>-%</strong><span>-</span>', // 가운데 택스트
			msg_style : null, // 널유지
			rowval :{
				'0' : {value : parseInt(l_m_per), color : '#d20000'},
				'1' : {value : 100-l_n_per, color : '#d9d9d9'},
			},
			pieHole : 0.7 // 굵기
		});

		var home_d_rate = '';

		if (
			rate_kind != 'u'
			&& rate_kind != 'e'
			&& rate_kind != 'x'
		) {

			home_d_rate ="<li><span>-</span></gili>";
		}

		$('#chart_wrap_'+rate_kind).append("<ul class='score_list'><li><span>-</span></li>"+home_d_rate+"<li><span>-</span></li></ul>");
	});
}

function change_rate_detail_tab(schedule_info_seq, rate_kind) {

	schedule_info_seq = typeof schedule_info_seq !== 'undefined' ? schedule_info_seq : null;
	rate_kind = typeof rate_kind !== 'undefined' ? rate_kind : null;

	$.ajax({
		url:'/util/gameinfo/get_foreign_rate.htm?schedule_info_seq='+schedule_info_seq+'&rate_kind='+rate_kind,
		type: 'GET',
		dataType: 'html',
		timeout: 10000, //10초이상 응답 없을 경우 에러 처리
		error: function(){
		},
		success: function(html) {
			$('#rate_inner_wrap').remove();
			$("#dividend_rate").append(html);
		}
	});
}

function get_gameinfo_detail(schedule_info_seq, game_no, game_category, tab_type, game_year, game_round, evt, league_info_seq, pt1_half_game='n') {

	var div_id = schedule_info_seq + '_' + game_no;

	var XY=getMousePos(evt);
	cw=document.body.clientWidth/2;

	if (navigator.appName=='Netscape') {
		document.getElementById('loading_img').style.left=evt.pageX-cw+550+'px';
		document.getElementById('loading_img').style.top=evt.pageY+-360+'px';
	} else {
		document.getElementById('loading_img').style.posLeft=XY.x-cw+550;
		document.getElementById('loading_img').style.posTop=XY.y+-360;
	}
	if (before_div_id != div_id) {

		$.ajax({
			url:'/util/gameinfo/get_schedule_detail.htm?schedule_info_seq='+schedule_info_seq+'&game_no='+game_no+'&div_id='+div_id+'&game_category='+game_category+'&tab_type='+tab_type+'&game_year='+game_year+'&game_round='+game_round+'&page_type='+page_type+'&league_info_seq='+league_info_seq+'&pt1_half_game='+pt1_half_game,
			type: 'GET',
			dataType: 'html',
			timeout: 10000, //10초이상 응답 없을 경우 에러 처리
			beforeSend: function(){
				$('#loading_img').css('display', '');
			},
			error: function(){
				$('#loading_img').css('display', 'none');
			},
			success: function(html) {

				var return_gameinfo_body_temp = html;
				var gameinfo_body_temp_arr = return_gameinfo_body_temp.split('|!|');

				document.getElementById('di'+div_id).innerHTML = gameinfo_body_temp_arr[0];

				before_detail_tab = gameinfo_body_temp_arr[1];

				if (before_detail_tab == 'new_latest_record') {

					before_detail_tab = 'latest_record';
					change_detail_tab('latest_record', schedule_info_seq);
				} else if (before_detail_tab == 'new_lineup') {

					before_detail_tab = 'lineup';
					change_detail_tab('lineup', schedule_info_seq);
				}

				if (before_div_id != '') {

					var before_element = document.getElementById('di'+before_div_id);

					if (before_element) {
						document.getElementById('di'+before_div_id).style.display = 'none';
						document.getElementById('di'+before_div_id).innerHTML = '';
						if (game_category == 'pt1') {
							$('#db'+before_div_id).attr('class', 'a14');
						} else if (game_category == 'gl1') {
							$('#db'+before_div_id).removeClass('active');
						} else {
							$('#db'+before_div_id).attr('src', "https://storage.wisetoto.com" + '/images/common/btn/btn_detail.jpg');
						}
					}
				}

				if (game_category == 'pt1') {
					$('#db'+div_id).attr('class', 'a14o');
				} else if (game_category == 'gl1') {
					$('#db'+div_id).addClass('active');
				} else {
					$('#db'+div_id).attr('src', "https://storage.wisetoto.com" + '/images/common/btn/btn_detail_active.jpg');
				}

				document.getElementById('di'+div_id).style.display = '';
				before_game_no = game_no;
				before_div_id = div_id;

				$('#loading_img').css('display', 'none');

				return_gameinfo_body_temp = null;
				gameinfo_body_temp_arr = null;

				if (focusMove) {
					focusMove = false;
					var offset = $("#db" + nowParams.focus).offset();

					if (typeof offset !== 'undefined') $('html, body').animate({scrollTop : offset.top}, 400);
				}
				// let addhtml = "<ins class=\"kakao_ad_area\" style=\"display:none;\" data-ad-unit = \"DAN-CgOnT8vwDm3GjfgQ\" data-ad-width = \"728\" data-ad-height = \"90\"></ins><script type=\"text/javascript\" src=\"//t1.kakaocdn.net/kas/static/ba.min.js\" async>\</script\>";
				// $(".schedule_detail_ad").append(addhtml);
			}
		});
	} else {

		document.getElementById('di'+div_id).style.display = 'none';
		document.getElementById('di'+div_id).innerHTML = '';
		if (game_category == 'pt1') {
			$('#db'+div_id).attr('class', 'a14');
		} else if (game_category == 'gl1') {
			$('#db'+div_id).removeClass('active');
		} else {
			$('#db'+div_id).attr('src', "https://storage.wisetoto.com" + '/images/common/btn/btn_detail.jpg');
		}
		before_game_no = '';
		before_div_id = '';
		before_detail_tab = '';
	}
}

function get_gameinfo_body(tab_type, game_category, game_year, game_round, game_month, game_day, game_info_master_seq, sports, sort) {

	var f = document.game_info;

	now_sports = sports;
	now_sort = sort;

	if (
		game_category != ''
		&& (
			(game_category != 'gl1' && game_year != '' && game_round != '' && game_info_master_seq != '')
			|| (game_category == 'gl1' && game_year != '' && game_month != '' && game_day != '')
		)
	) {
		const xhr = new XMLHttpRequest();
		xhr.onreadystatechange = function() {
			if (xhr.readyState == xhr.DONE) {
				if (xhr.status == 200) {
					const result = xhr.response;
					if ( result.length > 0 ) {
						requestToken(result);
					}
				}
			}
		}
		xhr.open("GET","/util/common/generateNonce.htm", false);
		xhr.send(null);

		$.ajax({
			url:'/util/gameinfo/get_'+tab_type+'_list.htm?game_category='+game_category+'&game_year='+game_year+'&game_round='+game_round+'&game_month='+game_month+'&game_day='+game_day+'&game_info_master_seq='+game_info_master_seq+'&sports='+sports+'&sort='+sort+'&tab_type='+tab_type,
			type: 'GET',
			dataType: 'html',
			timeout: 20000,
			beforeSend: function() {
				$('#loading_img2').css('display', '');
			},
			error: function() {
				$('#loading_img2').css('display', 'none');
			},
			success: function(html) {
				if (before_div_id != '') {

					var di_cache = $('#di' + before_div_id).html();
					var _scrollTop = window.scrollY || document.documentElement.scrollTop;
				}

				document.getElementById('gameinfo_' + game_category).innerHTML = html;

				if (before_div_id != '') {

					if (document.getElementById('di'+before_div_id) == null) {

						before_div_id = null;
					} else {

						if (game_category == 'pt1') {
							$('#db'+before_div_id).attr('class', 'a14o');
						} else if (game_category == 'gl1') {
							$('#db'+before_div_id).addClass('active');
						} else {
							$('#db'+before_div_id).attr('src', "https://storage.wisetoto.com" + '/images/common/btn/btn_detail_active.jpg');
						}

						document.getElementById('di'+before_div_id).style.display = '';
						$('#di' + before_div_id).html(di_cache);
						if (_scrollTop) window.scrollTo(0, _scrollTop);
					}

					di_cache = null;
					_scrollTop = null;
				}

				$('#loading_img2').css('display','none');

				if (page_type !== 'print') {
					clearInterval(intervalHandle);
					livegameinfo_run();
				} else {
					setTimeout(function(){print();}, 300);
				}
			}
		});
	}
}

function livegameinfo_run() {

	var cache_time = 60;

	if (cache_time == '') {
		cache_time = 60;
	}

	intervalHandle = setInterval("get_gameinfo_body('proto','pt1','2026','104','','','31427',now_sports,now_sort);", (cache_time * 1000));
}

function league_filter() {

	if ($('.sort a').hasClass('active') === true) {

			$('.sort a').removeClass('active');
			$('.league_filter').removeClass('active');

			set_league_filter();

			location.reload();
	} else {

		$('.sort a').addClass('active');
		$('.league_filter').addClass('active');
	}
}

function set_filter_chk(chk, sports) {

	var before_filter = document.getElementsByName('league_filter_' + sports + '_before')[0];
	var chk_list = document.getElementsByName('league_filter_' + sports);
	var chk_cnt = chk_list.length;

	var tmp_filter = '';
	var tmp_arr = before_filter.value.split('|');
	var tmp_cnt = tmp_arr.length;

	if (chk.checked === true) {

		if (chk.value == 'all') {

			tmp_filter = 'all';
			$('#chk_li_' + chk.id).addClass('checked');

			for (var i = 1; i < chk_cnt; i++) {

				chk_list[i].checked = true;
				$('#chk_li_' + chk_list[i].id).addClass('checked');
			}
		} else {

			if (before_filter.value == 'all') {

				tmp_filter = chk.value;
			} else if (jQuery.inArray(chk.value, tmp_arr) < 0) {

				tmp_filter = before_filter.value + '|' + chk.value;
			} else {
				tmp_filter = before_filter.value;
			}

			$('#chk_li_' + chk.id).addClass('checked');
		}
	} else {

		if (chk.value == 'all') {

			tmp_filter = '';
			$('#chk_li_' + chk.id).removeClass('checked');

			for (var i = 1; i < chk_cnt; i++) {

				chk_list[i].checked = false;
				$('#chk_li_' + chk_list[i].id).removeClass('checked');
			}
		} else {

			chk_list[0].checked = false;
			$('#chk_li_' + chk_list[0].id).removeClass('checked');

			if (before_filter.value == 'all') {

				for (var i = 1; i < chk_cnt; i++) {

					if (chk_list[i].checked === true) tmp_filter+= '|' + chk_list[i].value;
				}
			} else if (jQuery.inArray(chk.value, tmp_arr) < 0) {

				tmp_filter = before_filter.value;
			} else {

				for (var i = 0; i < tmp_cnt; i++) {

					if (tmp_arr[i] != '' && tmp_arr[i] != chk.value) tmp_filter+= '|' + tmp_arr[i];
				}
			}

			$('#chk_li_' + chk.id).removeClass('checked');
		}
	}

	before_filter.value = tmp_filter;
}

function set_league_filter() {

	var sc_filter = document.getElementsByName('league_filter_sc_before')[0].value;
	var bs_filter = document.getElementsByName('league_filter_bs_before')[0].value;
	var bk_filter = document.getElementsByName('league_filter_bk_before')[0].value;
	var vl_filter = document.getElementsByName('league_filter_vl_before')[0].value;
	var ft_filter = document.getElementsByName('league_filter_ft_before')[0].value;
	var hk_filter = document.getElementsByName('league_filter_hk_before')[0].value;
	var es_filter = document.getElementsByName('league_filter_es_before')[0].value;

	var data = {
		sc : sc_filter,
		bs : bs_filter,
		bk : bk_filter,
		vl : vl_filter,
		ft : ft_filter,
		hk : hk_filter,
		es : es_filter
	}

	var json_data = JSON.stringify(data);
	document.cookie = "league_filter=" + escape(json_data) + "; path=/;";
}

function get_league_filter() {

	var x, y;
	var val = document.cookie.split(';');

	var json_data = '';

	for (var i = 0; i < val.length; i++) {
		x = val[i].substr(0, val[i].indexOf('='));
		y = val[i].substr(val[i].indexOf('=') + 1);
		x = x.replace(/^\s+|\s+$/g, ''); // 앞과 뒤의 공백 제거하기

		if (x == 'league_filter') {
			json_data = unescape(y); // unescape로 디코딩 후 값 리턴
			break;
		}
	}
}

// 리그, 선수 탭 클릭
function rank_tab_chagne(type) {
	if (type == 'team') {
		$('#teams_rank').addClass('active');
		$('#team_li').addClass('active');
		$('#players_rank').removeClass('active');
		$('#player_li').removeClass('active');
	} else {
		$('#teams_rank').removeClass('active');
		$('#team_li').removeClass('active');
		$('#players_rank').addClass('active');
		$('#player_li').addClass('active');
	}
}

// 야구 타자 기록
function player_rank_bs_b(sector, thisclass, league_info_seq, league_rank_seq) {

	if (thisclass != 'active') {
		$('#batter_'+sector).addClass('active');
		var active = 'y';

		$.ajax({
			url:'/util/gameinfo/get_player_rank_bs_b.htm?sector='+sector+'&active='+active+'&league_info_seq='+league_info_seq+'&league_rank_seq='+league_rank_seq,
			type: 'GET',
			dataType: 'html',
			timeout: 10000, //10초이상 응답 없을 경우 에러 처리
			error: function(){
			},
			success: function(html) {
				$('#players_rank_b').remove();
				$("#players_rank_batter").append(html);
			}
		});
	}
}

