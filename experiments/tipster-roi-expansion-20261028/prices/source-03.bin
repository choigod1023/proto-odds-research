			$('.impactify-AM-player').show();
		}

	} else {

		if ( typeof($('.impactify-AM-player')) != "undefined" && $('.impactify-AM-player') !== null ) {

			$('.impactify-AM-player').hide();
		}
		floatingVideo.removeClass('fixed');

	}

});

