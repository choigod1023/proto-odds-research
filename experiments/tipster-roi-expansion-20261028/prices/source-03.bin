				<script>

		function setBannerClick(id) {
			var Data = { "id": id};
			var Url = '/util/etc/banner_img_click_redis.php';
			$.ajax({
				url: Url, // 목적지
				data: Data,
				type:"POST",
				dataType:"json",
				success: function(result) {
					if (result) {

					} else {
						console.log(result);
					}
				}
			});
		}

		var slideIndex = 0;
		var intervalBanner;

		showSlides(slideIndex);

		function nextSlide() {
			showSlides(slideIndex += 1);
		}

		function prevSlide() {
			showSlides(slideIndex -= 1);
		}

		function showSlides(n) {

			var i;
			var slides = document.querySelectorAll('.bannerSlideList');
			var dots = document.querySelectorAll('.dot');

			if (n >= slides.length) {n = 0}
			if (n < 0) {n = (slides.length - 1)}

			for (i = 0; i < slides.length; i++) {
				slides[i].style.display = 'none';
			}

			for (i = 0; i < dots.length; i++) {
				dots[i].className = dots[i].className.replace(' slick-active', '');
			}

			slideIndex = n;

			slides[slideIndex].style.display = 'block';
			dots[slideIndex].className += ' slick-active';

			clearInterval(intervalBanner);
			mainbanner_run();
		}

		function mainbanner_run() {
			intervalBanner = setInterval("nextSlide(1);", 10000);
		}
		</script>
