$(document).ready(function(){
	//Click event to scroll to top
	$('.scrollToBottom').click(function(){
		$(document).scrollTop($(document).height());
		return false;
	});
});

$(window).resize(function() {
	var banner_right = $('.banner_right'),
		windowWidth = $(window).width(),
		floatingScroll = $(window).scrollTop();
	if (windowwidth < 1200) banner_right.addClass('fixed');
	else banner_right.removeClass('fixed');

	if (windowWidth >= 1720 || floatingScroll >= 640) {

		if( floatingVideo.length == 1 ){

			floatingVideo.append(ad_s);
			floatingVideo.append(ad_i);
		}
		if ( typeof($('.impactify-AM-player')) != "undefined" && $('.impactify-AM-player') !== null ) {

			$('.impactify-AM-player').show();
		}

	} else {

		if ( typeof($('.impactify-AM-player')) != "undefined" && $('.impactify-AM-player') !== null ) {

			$('.impactify-AM-player').hide();
		}
		floatingVideo.children().remove();

	}
});

// 우측 리모콘 191106 추가 우측하단 동영상광고 220927 추가
$(window).scroll(function(){

	var floatingMenu = $('.remote_control'),
		floatingVideo = $('.video_right'),
		windowWidth = $(window).width(),
		floatingScroll = $(window).scrollTop();

	if (floatingScroll >= 670) floatingMenu.addClass('fixed');
