__pycache__/
*.py[cod]
.venv/
venv/
.env
.DS_Store
.ipynb_checkpoints/

# 원본 스크래핑 응답(용량 큼) — 재현은 스크립트로
data/raw/**/*.html
data/raw/**/*.html.gz

# 세션 쿠키 등 민감정보
cookies.txt
*.cookie

# 분석 중간 산출물 (재현은 build_dataset.py로)
data/processed/*.csv
!docs/data/*.json
data/raw/*.log
data/*.log
# 실행 중 배타 잠금은 데이터가 아니다. Git에 올라가면 다음 배포가 이를 실제
# 보유 중인 잠금으로 오인해 판정 생성이 멈춘다.
data/raw/**/*.lock
data/runtime/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# 스냅샷 백업
data/raw/snapshots/*.bak

# 사이트 소스 빌드 (산출물은 docs/ 에 커밋한다)
web/node_modules/
web/.vite/

# git worktree 작업 폴더 — 커밋되면 gitlink(서브모듈)로 잡혀
# GitHub Pages 배포가 "No url found for submodule path" 로 통째로 실패한다
.claude/worktrees/

# 스냅샷 마이그레이션 잔재 — 쪼갠 뒤 남는 원본 백업(100MB 초과라 push 불가)
data/raw/snapshots/odds_timeseries.csv.bak
